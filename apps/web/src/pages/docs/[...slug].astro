---
// Every wiki page, at /docs/<slug>. The `docs` collection (src/content.config.ts) reads the
// Markdown in place, lib/docs-slug.ts maps each path to its slug, and lib/docs.ts joins the
// pages to .wikimap.yaml for the title and the sidebar. `index.md` is the empty slug, so it
// renders at /docs, and a page under `generated/` has no `generated/` in its URL.
import { render } from "astro:content";

import DocsLayout from "@web/layouts/DocsLayout.astro";
import { docsUi } from "@web/content/docs";
import { loadDocs } from "@web/lib/docs";
import { moduleTierOf, pageDescription } from "@web/lib/docs-text";
import { siteName } from "@web/site";

export async function getStaticPaths() {
  const { items, pages } = await loadDocs();
  return items.map(({ page, entry }) => ({
    params: { slug: page.slug === "" ? undefined : page.slug },
    props: { page, entry, pages },
  }));
}

const { page, entry, pages } = Astro.props;
const { Content, headings } = await render(entry);

const body = entry.body ?? "";
const title =
  page.slug === ""
    ? `${docsUi.titleSuffix} | ${siteName}`
    : `${page.title} | ${docsUi.titleSuffix} | ${siteName}`;
const description = pageDescription(body) || undefined;
const tier = page.isModule ? moduleTierOf(body) : undefined;
---

<DocsLayout
  title={title}
  description={description}
  current={page}
  pages={pages}
  headings={headings}
  tier={tier}
  stampSource={body}
>
  <Content />
</DocsLayout>
