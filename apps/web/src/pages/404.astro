---
// The wrong-path page. Astro prerenders it to dist/client/404.html, and wrangler.jsonc's
// `assets.not_found_handling: "404-page"` is what makes Cloudflare serve it (with a real
// 404 status) for an address that matches no asset and no route.
//
// No markup of its own: every error screen is blocks/error-state.tsx, and every word is
// content/errors.ts. Change the copy there, not here.
//
// No `client:*` directive, deliberately. ErrorState is static, so this page ships zero
// JavaScript for it.
import { siteName } from "@web/site";
import { ErrorState } from "@web/blocks/error-state";
import { errors } from "@web/content/errors";
import Layout from "../layouts/Layout.astro";
---

<Layout title={`${errors.notFound.title} — ${siteName}`} noindex>
  <ErrorState
    code={errors.notFound.code}
    title={errors.notFound.title}
    description={errors.notFound.description}
    primaryAction={{ label: errors.notFound.homeLabel, href: "/" }}
  />
</Layout>
