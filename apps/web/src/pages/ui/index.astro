---
// /ui, the Saasaloy UI index (plan 0121, Phase 2), from the round 1 mockup the owner
// approved on 2026-11-22. A hero with the install command and the base-nova note, a row of
// filter chips, and one card per block: a wireframe, the registry name and one line. The
// blocks come from apps/web/registry.json (lib/ui-registry.ts), so a new item joins the
// grid with no edit here.
//
// The chips filter with one small inline script: it hides the cards of other kits or
// categories and marks the pressed chip. The kit chips (ink, dusk; plan 0121, Phase 7)
// come first. Without JavaScript every card shows. The grid stretches its
// cards, so cards in one row share one height (DESIGN.md).
import UiLayout from "@web/layouts/UiLayout.astro";
import { BlockThumb } from "@web/components/block-thumb";
import { CommandField } from "@web/components/command-field";
import { uiRegistry } from "@web/content/ui-registry";
import InlineCode from "@web/components/InlineCode.astro";
import { uiBlocks } from "@web/lib/ui-registry";

const blocks = uiBlocks();
// One chip for each kit, then one for each block type. A card carries both its kit and
// its type, so either chip finds it.
const kits = [...new Set(blocks.map((block) => block.kit ?? ""))]
  .filter((kit) => Object.hasOwn(uiRegistry.kits, kit))
  .map((kit) => ({ id: kit, label: uiRegistry.kits[kit] }));
const categories = [...new Set(blocks.map((block) => block.category))]
  .filter((category) => Object.hasOwn(uiRegistry.categories, category))
  .map((category) => ({
    id: category,
    label: uiRegistry.categories[category],
  }));
const chips = [...kits, ...categories];
const copy = uiRegistry.index;
const sampleCommand = `npx shadcn@latest add @saasaloy/${copy.sampleBlock}`;
const chipClass =
  "border-highlight text-highlight hover:bg-muted aria-pressed:bg-primary aria-pressed:text-primary-foreground aria-pressed:border-primary focus-visible:outline-ring h-9 shrink-0 cursor-pointer border px-4 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2";
---

<UiLayout
  title={uiRegistry.meta.title}
  description={uiRegistry.meta.description}
  current="blocks"
>
  <main id="main" tabindex="-1" class="outline-none">
    <section class="section-container-hero grid items-center gap-10 pt-12 pb-10 lg:grid-cols-[1.1fr_1fr] lg:pt-16">
      <div class="@container flex flex-col gap-5">
        <h1 class="text-display">
          <span class="text-foreground block">{copy.titleLead}</span>
          <span class="text-primary block">{copy.titleAccent}</span>
        </h1>
        <p class="text-lead text-muted-foreground">{copy.lead}</p>
        <CommandField command={sampleCommand} size="lg" client:visible />
        <div class="text-muted-foreground flex flex-col gap-1 text-sm">
          <p>{copy.styleNote}</p>
          <p>
            <InlineCode text={copy.registriesNote} />
          </p>
        </div>
      </div>
      <svg
        viewBox="0 0 600 300"
        aria-hidden="true"
        class="text-highlight hidden w-full lg:block"
        fill="none"
      >
        <g class="stroke-current" stroke-width="1">
          <path d="M20 20h20M30 10v20M560 20h20M570 10v20M20 280h20M30 270v20M560 280h20M570 270v20" />
          <rect x="90.5" y="40.5" width="420" height="210" class="fill-card" />
          <path d="M90.5 70.5h420" />
          <rect x="102.5" y="50.5" width="10" height="10" />
          <rect x="120.5" y="50.5" width="10" height="10" />
          <rect x="138.5" y="50.5" width="10" height="10" />
          <rect x="340.5" y="90.5" width="140" height="130" />
          <path d="M340.5 90.5l140 130M480.5 90.5l-140 130" />
        </g>
        <rect x="120" y="100" width="190" height="18" class="fill-primary" />
        <rect x="120" y="132" width="160" height="8" class="fill-border" />
        <rect x="120" y="148" width="136" height="8" class="fill-border" />
        <rect x="120" y="178" width="84" height="22" class="fill-highlight" />
      </svg>
    </section>

    <section
      class="section-container-hero flex flex-col gap-6"
      aria-labelledby="ui-blocks-heading"
    >
      <h2 id="ui-blocks-heading" class="sr-only">
        {copy.gridLabel}
      </h2>
      <div
        role="group"
        aria-label={copy.filterLabel}
        class="-mx-1 flex gap-3 overflow-x-auto px-1 py-1"
        data-ui-filters
      >
        <button
          type="button"
          class={chipClass}
          aria-pressed="true"
          data-filter=""
        >
          {copy.all}
        </button>
        {chips.map((chip) => (
          <button
            type="button"
            class={chipClass}
            aria-pressed="false"
            data-filter={chip.id}
          >
            {chip.label}
          </button>
        ))}
      </div>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {blocks.map((block) => (
          <li
            class="flex"
            data-filters={[block.kit, block.category].filter(Boolean).join(" ")}
          >
            <a
              href={`/ui/blocks/${block.name}`}
              class="group border-border bg-card hover:border-highlight focus-visible:outline-ring flex w-full flex-col border transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              <span class="border-border bg-background text-highlight block border-b p-3">
                <BlockThumb block={block.block} className="aspect-2/1 w-full" />
              </span>
              <span class="flex flex-1 flex-col gap-1 px-4 py-3">
                <span class="text-foreground group-hover:text-primary font-mono text-base font-semibold">
                  {block.name}
                </span>
                <span class="text-muted-foreground text-sm">
                  {block.description}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</UiLayout>

<script>
  // The filter chips. A press marks the chip and hides every card of another category.
  const group = document.querySelector("[data-ui-filters]");
  const cards = document.querySelectorAll<HTMLElement>("[data-filters]");
  group?.addEventListener("click", (event) => {
    const chip =
      event.target instanceof Element
        ? event.target.closest<HTMLElement>("[data-filter]")
        : null;
    if (!chip) {
      return;
    }
    const filter = chip.dataset.filter ?? "";
    for (const other of group.querySelectorAll("[data-filter]")) {
      other.setAttribute("aria-pressed", String(other === chip));
    }
    for (const card of cards) {
      card.hidden =
        filter !== "" &&
        !(card.dataset.filters ?? "").split(" ").includes(filter);
    }
  });
</script>
