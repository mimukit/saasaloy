---
import { locale, siteName } from "@web/site";
import { CommandField } from "@web/components/command-field";
import { BuiltOn } from "@web/blocks/built-on";
import { Faq } from "@web/blocks/faq";
import { Footer } from "@web/blocks/footer";
import { Hero } from "@web/blocks/hero";
import { ModuleCatalog } from "@web/blocks/module-catalog";
import { Navbar } from "@web/blocks/navbar";
import { Problem } from "@web/blocks/problem";
import { Providers } from "@web/blocks/providers";
import { SiteSource } from "@web/blocks/site-source";
import { Stages } from "@web/blocks/stages";
import { Start } from "@web/blocks/start";
import { landing, ui } from "@web/content/landing";
import { agentPrompt } from "@web/content/prompts";
import { interpolate } from "@web/lib/interpolate";
import { loadModuleCatalog } from "@web/lib/module-registry";
import { homeGraph } from "@web/lib/structured-data";
import Layout from "../layouts/Layout.astro";

// This page carries no copy of its own — the tab title and meta description come from
// landing.meta.*, which spells the brand as a `{siteName}` token. Every block reads its
// own words from the same file (src/content/landing.ts).

// This page composes itself from explicit imports and nothing else.

// The catalog rows come from modules/*/registry-item.json, read once at build time.
const catalogRows = loadModuleCatalog();

const initPrompt = agentPrompt("init");

const description = interpolate(landing.meta.description, { siteName });
// The graph names the public origin, never the dev host, so a missing `site` fails the build.
if (!Astro.site) {
  throw new Error(
    "Set `site` in astro.config.mjs; the home page JSON-LD needs it."
  );
}
const jsonLd = homeGraph({ site: Astro.site, siteName, description, locale });
---

{/*
  THE SECTION RECIPE. Each section is one import above and one line below.
    - Remove a section: delete its line here, its import above, and its file in
      src/blocks/. Blank its navbar and footer labels in landing.ts so no link
      points at a section that is gone.
    - Reorder: move the lines. The blocks share one spacing rhythm, so any order works.
    - Add one back: copy the block file in, then add the import and the line.

  The page is composed from src/blocks/*, one file per block.
  Blocks render to static HTML by default; only the parts that need browser state carry a
  client directive, and each one is deliberate:
    - Navbar       client:idle    — mobile menu, above the fold, so hydrate when the
                                    browser goes idle rather than waiting for scroll.
    - CommandField client:visible — the copy button, in the hero and in the closing
                                    start block. It reaches its block through the
                                    block's `commandField` slot. `visible` hydrates each
                                    field once it is on screen, so the hero's hydrates
                                    right after load without competing with the first
                                    paint, and the closing one waits for the scroll.
                                    Before it hydrates, or with JavaScript off, the
                                    command is plain selectable text.
  Every other block ships no island. The stages and the catalog carry the compact copy
  buttons as hidden HTML, and the one inline script at the foot of <main> shows them and
  copies their `data-copy-text`, so they add no React to the page.
  Beyond that the blocks ship no JavaScript at all. The FAQ opens and closes with native
  <details>, the catalog filter and the stages highlight are CSS `:has()`, and all motion
  is CSS. The theme
  toggle sits inside the navbar and needs no island of its own: the pre-paint script
  Layout.astro emits drives it.
  Never reach for a blanket `client:load` here — it would hydrate the whole page.

  The sections follow the round 10 mockup, with the built-on and problem sections of plan
  0092 after the stages, and a `blueprint-rule` between each pair. The hero draws its own
  rule at its foot, the bottom edge of the first viewport, so no rule follows it here.
  The footer draws its own rules.
*/}
<Layout
  title={interpolate(landing.meta.title, { siteName })}
  description={description}
  jsonLd={jsonLd}
>
  <Navbar client:idle siteName={siteName} />
  <main id="main" tabindex="-1">
    <Hero rows={catalogRows}>
      <CommandField
        slot="commandField"
        client:visible
        size="lg"
        command={landing.hero.command}
        agentPrompt={initPrompt}
      />
    </Hero>
    <Stages rows={catalogRows} />
    <div aria-hidden="true" class="blueprint-rule"></div>
    <BuiltOn />
    <div aria-hidden="true" class="blueprint-rule"></div>
    <Problem />
    <div aria-hidden="true" class="blueprint-rule"></div>
    <ModuleCatalog rows={catalogRows} />
    <div aria-hidden="true" class="blueprint-rule"></div>
    <Providers />
    <div aria-hidden="true" class="blueprint-rule"></div>
    <SiteSource />
    <div aria-hidden="true" class="blueprint-rule"></div>
    <Faq siteName={siteName} />
    <div aria-hidden="true" class="blueprint-rule"></div>
    <Start>
      <CommandField
        slot="commandField"
        client:visible
        command={landing.start.command}
        agentPrompt={initPrompt}
      />
    </Start>
    <span
      role="status"
      aria-live="polite"
      class="sr-only"
      data-copy-status=""
    ></span>
    <script
      is:inline
      define:vars={{
        announcements: {
          prompt: ui.commandField.promptCopiedAnnouncement,
          cli: ui.commandField.copiedAnnouncement,
        },
      }}
    >
      const status = document.querySelector("[data-copy-status]");
      for (const group of document.querySelectorAll("[data-copy-controls]")) {
        group.hidden = false;
      }
      const timers = new WeakMap();
      document.addEventListener("click", async (event) => {
        const button = event.target.closest?.("[data-copy-text]");
        if (!button) {
          return;
        }
        try {
          await navigator.clipboard.writeText(button.dataset.copyText);
        } catch {
          // No clipboard access: the command stays on screen to copy by hand.
          return;
        }
        button.dataset.copied = "";
        status.textContent = announcements[button.dataset.copyKind];
        clearTimeout(timers.get(button));
        timers.set(
          button,
          setTimeout(() => {
            delete button.dataset.copied;
            status.textContent = "";
          }, 2000)
        );
      });
    </script>
  </main>
  <Footer siteName={siteName} />
</Layout>
