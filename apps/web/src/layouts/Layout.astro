---
// The one document shell for every page. It owns <html>/<head>/<body> and the single
// import of the web theme, so a page is only ever its own content — no page may
// duplicate the shell or import a stylesheet again. web.css imports brand.css, the
// tokens, and brand.css imports the shared globals.css.
import "@web/styles/web.css";
import { locale, siteName } from "@web/site";
import { landing, ui } from "@web/content/landing";
import { interpolate } from "@web/lib/interpolate";
import { THEME_INIT_SCRIPT } from "@web/lib/theme";
import { analyticsToken } from "@web/lib/analytics";

interface Props {
  title: string;
  description?: string;
  /**
   * Keep the page out of search indexes. The error pages set it: they get
   * `<meta name="robots" content="noindex">` and no canonical URL.
   */
  noindex?: boolean;
  /** A JSON-LD object, written into the head as one `application/ld+json` script. */
  jsonLd?: object;
}

const { title, description, noindex = false, jsonLd } = Astro.props;

// `Astro.site` is the `site` origin in astro.config.mjs. It is always set there, so the
// canonical URL never falls back to the dev server's host.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// The link preview image, 1200×630. public/og.png is the README module-map banner, padded
// to that ratio. The URL is absolute, because a preview crawler resolves nothing.
const ogImage = new URL("/og.png", Astro.site).href;
const ogImageAlt = interpolate(landing.meta.imageAlt, { siteName });

// `<` escaped so no string in the data can close the script element early.
const jsonLdScript = jsonLd
  ? JSON.stringify(jsonLd).replaceAll("<", String.raw`\u003c`)
  : undefined;

// Cloudflare Web Analytics, cookieless. A build with no token (../lib/analytics.ts)
// ships no beacon and no mention of one.
const analyticsBeacon = analyticsToken
  ? JSON.stringify({ token: analyticsToken })
  : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {/*
      Explicit icon link, not the implicit /favicon.ico lookup. Without a link the
      browser guesses /favicon.ico, and Chrome tags that guess `Sec-Fetch-Site:
      cross-site`, which the Astro dev server blocks with a `[router]` warning
      (astro/dist/vite-plugin-astro-server/sec-fetch.js). A declared same-origin
      link never gets that treatment. Replace public/favicon.svg with the project mark.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    {description && <meta name="description" content={description} />}
    {/*
      The link preview. Every page gets the title, the URL, the image and the card type;
      a page that passes a description gets it here too.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {jsonLdScript && (
      <script is:inline type="application/ld+json" set:html={jsonLdScript} />
    )}
    {/*
      Pre-paint theme resolution. This runs synchronously in <head>, BEFORE the browser
      paints, so a visitor who chose dark never sees a white flash. `is:inline` keeps Astro
      from bundling it into a deferred module, which would defeat the whole point —
      `<script type="module">` is deferred by specification and always runs too late.
      The script body is lib/theme.ts's THEME_INIT_SCRIPT, imported above and baked into
      this HTML at build time, so the layout holds no copy of it: it reads the stored
      choice, falls back to the light theme, and also drives every
      `[data-theme-toggle]` on the page through one delegated listener. That is why
      blocks/theme-toggle needs no client directive. Do not inline a second
      resolver here, and do not turn this into an import.
    */}
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    {analyticsBeacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={analyticsBeacon}
      />
    )}
  </head>
  {/*
    `blueprint-grid` (styles/web.css) draws the graph paper behind the whole page as one
    continuous background, so no section paints a band of its own.
  */}
  <body class="bg-background text-foreground blueprint-grid min-h-dvh font-sans antialiased">
    {/*
      The first Tab stop on every page. It stays off screen until focused, then jumps past
      the navbar to the page's <main>. Every page and the error block give their <main>
      `id="main"` and `tabindex="-1"`, so focus lands there too.
    */}
    <a
      href="#main"
      class="bg-background focus-visible:ring-ring/50 sr-only z-100 border px-4 py-2 text-sm font-medium focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus-visible:ring-3"
    >
      {ui.layout.skipToContent}
    </a>
    <slot />
  </body>
</html>
