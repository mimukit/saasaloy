{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/modules/*/registry-item.json",
        "$TURBO_ROOT$/packages/cli/package.json",
        "$TURBO_ROOT$/llms.txt",
        "$TURBO_ROOT$/packages/cli/templates/base/packages/ui/src/**",
        "$TURBO_ROOT$/packages/cli/templates/base/packages/config/src/**",
        "$TURBO_ROOT$/packages/cli/templates/themes/**",
        "$TURBO_ROOT$/modules/auth/files/ui/blocks/**",
        "$TURBO_ROOT$/modules/waitlist/files/ui/blocks/**",
        "$TURBO_ROOT$/modules/shell/files/ui/components/shell/**",
        "$TURBO_ROOT$/scripts/ts-resolve-hook.ts",
        "$TURBO_ROOT$/scripts/config-shim.ts",
        "$TURBO_ROOT$/docs/wiki/**",
        "$TURBO_ROOT$/docs/wiki/.wikimap.yaml"
      ]
    }
  }
}
