{
  "extends": "@repo/tsconfig/base.json",
  "compilerOptions": {
    // The repo's own tooling runs under plain Node (`pnpm deploy:production` is
    // `node packages/tooling/src/deploy-production.ts`), which resolves the real filename
    // rather than a bundler's guess. So every relative import here carries its `.ts`, as
    // in `packages/env`. The tests run on Vitest through the root `vitest.config.ts`.
    "types": ["node"]
  },
  "include": ["src"]
}
