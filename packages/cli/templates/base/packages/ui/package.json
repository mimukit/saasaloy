{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./content/*": "./src/content/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./blocks/*": "./src/blocks/*.tsx",
    "./containers/*": "./src/containers/*.tsx"
  },
  "scripts": {
    "clean": "rimraf -g dist \"*.tsbuildinfo\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.37.0",
    "shadcn": "4.19.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": "19.2.8"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  }
}
