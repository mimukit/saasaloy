---
import { siteName } from "@repo/ui";
import Layout from "../layouts/Layout.astro";
---

<Layout title={`Terms of Service — ${siteName}`}>
  <main class="mx-auto my-16 max-w-2xl px-6 leading-[1.6]">
    <h1 class="mb-6 text-3xl font-bold tracking-tight">Terms of Service</h1>
    <p class="mb-4">Placeholder terms for {siteName}. Replace with your own before launch.</p>
    <p><a href="/" class="hover:underline">← Home</a></p>
  </main>
</Layout>
