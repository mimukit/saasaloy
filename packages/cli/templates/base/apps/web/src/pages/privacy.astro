---
// This file's name is the route. `config.app.legal.privacyPath` is what the footer links, so rename
// this page and that value in the same edit, or the link 404s.
//
// The words live in src/legal/privacy.md, the one source for this page and for its Markdown
// copy at `/privacy.md` (src/pages/[page].md.ts). Write your policy there, as Markdown;
// `{siteName}` in it becomes the product name.
import { siteName } from "@repo/ui";
import Layout from "../layouts/Layout.astro";
import { legalHtml, legalTitle } from "../lib/agent-document";

const html = await legalHtml("privacy");
---

<Layout title={`${legalTitle("privacy")} — ${siteName}`}>
  <main
    id="main"
    tabindex="-1"
    class="mx-auto my-16 max-w-2xl px-6 leading-[1.6] [&_a]:hover:underline [&_h1]:mb-6 [&_h1]:text-3xl [&_h1]:font-bold [&_h1]:tracking-tight [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:text-xl [&_h2]:font-semibold [&_li]:mb-2 [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:ps-6"
  >
    <Fragment set:html={html} />
    <p>
      <a href="/" class="hover:underline">
        ← Home
      </a>
    </p>
  </main>
</Layout>
