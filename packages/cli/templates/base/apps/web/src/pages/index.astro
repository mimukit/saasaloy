---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { siteName } from "@repo/ui";
import Layout from "../layouts/Layout.astro";

// File-based landing-page sections. Every module in ../sections default-exports an
// Astro component; dropping `sections/<name>.astro` puts it on the landing page with
// no edit here — the same file-drop convention as api's routes/ and db's schema/ globs.
// Sorted filename order gives deterministic placement; empty-safe (the base ships none).
const sectionModules = import.meta.glob<{ default: AstroComponentFactory }>(
  "../sections/*.astro",
  { eager: true },
);
const sections = Object.keys(sectionModules)
  .sort()
  .map((key) => sectionModules[key].default);
---

<Layout title={`${siteName} — coming soon`} description={`${siteName}, a Cloudflare-native SaaS.`}>
  <div class="grid min-h-dvh place-items-center p-8 text-center">
    <main class="max-w-[40rem]">
      <h1 class="mb-2 text-[clamp(2rem,6vw,3.5rem)] font-bold tracking-tight">{siteName}</h1>
      <p class="text-lg leading-[1.6] opacity-80">
        A Cloudflare-native SaaS, scaffolded with Saasaloy.
      </p>
      <p class="mt-4 text-lg leading-[1.6] opacity-80">
        Add features with <code class="font-mono">saasaloy add &lt;module&gt;</code>.
      </p>
      {sections.map((Section) => <Section />)}
      <nav class="mt-8 text-[0.9rem] opacity-70">
        <a href="/terms" class="hover:underline">Terms</a> · <a href="/privacy" class="hover:underline">Privacy</a>
      </nav>
    </main>
  </div>
</Layout>
