---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { siteName } from "@repo/ui";
import { Cta } from "@repo/ui/blocks/cta";
import { Faq } from "@repo/ui/blocks/faq";
import { FeatureGrid } from "@repo/ui/blocks/feature-grid";
import { Footer } from "@repo/ui/blocks/footer";
import { Hero } from "@repo/ui/blocks/hero";
import { Navbar } from "@repo/ui/blocks/navbar";
import { PricingTable } from "@repo/ui/blocks/pricing-table";
import { ThemeToggle } from "@repo/ui/blocks/theme-toggle";
import { landing } from "@repo/ui/content/landing";
import { interpolate } from "@repo/ui/lib/interpolate";
import Layout from "../layouts/Layout.astro";

// This page carries no copy of its own — the tab title and meta description come from
// landing.meta.*, which spells the brand as a `{siteName}` token. Every block reads its
// own words from the same file (packages/ui/src/content/landing.ts).

// File-based landing-page sections. Every module in ../sections default-exports an
// Astro component; dropping `sections/<name>.astro` puts it on the landing page with
// no edit here — the same file-drop convention as api's routes/ and db's schema/ globs.
// Sorted filename order gives deterministic placement; empty-safe (the base ships none).
const sectionModules = import.meta.glob<{ default: AstroComponentFactory }>(
  "../sections/*.astro",
  { eager: true }
);
const sections = Object.keys(sectionModules)
  .toSorted()
  .map((key) => sectionModules[key].default);
---

{
  /*
  The page is composed from @repo/ui/blocks/*, each reached by its own subpath export.
  Blocks render to static HTML by default; only the three that need browser state carry
  a client directive, and each one is deliberate:
    - Navbar       client:idle    — mobile menu toggle, above the fold, so hydrate when
                                    the browser goes idle rather than waiting for scroll.
    - PricingTable client:visible — monthly/annual toggle, below the fold.
    - Faq          client:visible — accordion, below the fold.
  Hero, FeatureGrid, Cta and Footer take no directive and ship no JavaScript at all.
  ThemeToggle is the interesting case: it is interactive yet takes no directive either,
  because its behaviour comes from the pre-paint inline script Layout.astro emits, not
  from React. Giving it a `client:*` would ship a hydration runtime for a button that
  has no onClick. It sits here rather than inside Navbar so that navbar.tsx stays the
  landing blocks' file alone, and it carries its own positioning: fixed to the corner,
  clear of the sticky header's own controls at every width.
  Never reach for a blanket `client:load` here — it would hydrate the whole page.
*/
}
<Layout
  title={interpolate(landing.meta.title, { siteName })}
  description={interpolate(landing.meta.description, { siteName })}
>
  <Navbar client:idle siteName={siteName} />
  <ThemeToggle
    className="border-border/60 bg-background/80 fixed right-4 bottom-4 z-50 shadow-sm backdrop-blur"
  />
  <main>
    <Hero siteName={siteName} />
    <FeatureGrid />
    <PricingTable client:visible />
    <Faq client:visible />
    <Cta siteName={siteName} />
    {
      sections.length > 0 && (
        <div class="mx-auto w-full max-w-6xl px-6 pb-20">
          {sections.map((Section) => (
            <Section />
          ))}
        </div>
      )
    }
  </main>
  <Footer siteName={siteName} />
</Layout>
