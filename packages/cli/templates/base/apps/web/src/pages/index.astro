---
import { siteName } from "@repo/ui";
import { Audience } from "@repo/ui/blocks/audience";
import { Cta } from "@repo/ui/blocks/cta";
import { Faq } from "@repo/ui/blocks/faq";
import { FeatureGrid } from "@repo/ui/blocks/feature-grid";
import { Footer } from "@repo/ui/blocks/footer";
import { Hero } from "@repo/ui/blocks/hero";
import { HowItWorks } from "@repo/ui/blocks/how-it-works";
import { LogoCloud } from "@repo/ui/blocks/logo-cloud";
import { Navbar } from "@repo/ui/blocks/navbar";
import { PainPoints } from "@repo/ui/blocks/pain-points";
import { PricingTable } from "@repo/ui/blocks/pricing-table";
import { Showcase } from "@repo/ui/blocks/showcase";
import { Testimonials } from "@repo/ui/blocks/testimonials";
import { landing } from "@repo/ui/content/landing";
import { interpolate } from "@repo/ui/lib/interpolate";
import Layout from "../layouts/Layout.astro";

// This page carries no copy of its own — the tab title and meta description come from
// landing.meta.*, which spells the brand as a `{siteName}` token. Every block reads its
// own words from the same file (packages/ui/src/content/landing.ts).

// This page composes itself from explicit imports and nothing else. A module that ships
// UI writes a block into packages/ui/src/blocks/ plus a small island under
// src/components/ that feeds it, and then tells you to place it here; the module never
// puts itself on the page. Read the module's own skill for the import line and where it
// suggests the component goes, then decide the position yourself.
---

{/*
  THE SECTION RECIPE. Each section is one import above and one line below.
    - Remove a section: delete its line here, its import above, and its file in
      packages/ui/src/blocks/. Blank its navbar and footer labels in landing.ts so no link
      points at a section that is gone.
    - Reorder: move the lines. The blocks share one spacing rhythm, so any order works.
    - Add one back: copy the block file in, then add the import and the line.

  The page is composed from @repo/ui/blocks/*, each reached by its own subpath export.
  Blocks render to static HTML by default; only the two that need browser state carry a
  client directive, and each one is deliberate:
    - Navbar       client:idle    — mobile menu, above the fold, so hydrate when the
                                    browser goes idle rather than waiting for scroll.
    - PricingTable client:visible — monthly/annual toggle, below the fold.
  Every other block ships no JavaScript at all. The FAQ and the pain points open and close
  with native <details>, and all motion is CSS. The footer adds one inline script that
  writes the current year. The theme toggle sits inside the navbar and needs no island of
  its own: the pre-paint script Layout.astro emits drives it.
  Never reach for a blanket `client:load` here — it would hydrate the whole page.
*/}
<Layout
  title={interpolate(landing.meta.title, { siteName })}
  description={interpolate(landing.meta.description, { siteName })}
>
  <Navbar client:idle siteName={siteName} />
  <main id="main" tabindex="-1">
    <Hero siteName={siteName} />
    <LogoCloud />
    <PainPoints siteName={siteName} />
    <HowItWorks siteName={siteName} />
    <FeatureGrid siteName={siteName} />
    <Showcase siteName={siteName} />
    <Audience siteName={siteName} />
    <Testimonials siteName={siteName} />
    <PricingTable client:visible siteName={siteName} />
    <Faq siteName={siteName} />
    <Cta siteName={siteName} />
  </main>
  <Footer siteName={siteName} />
</Layout>
