{
  "name": "saasaloy-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Saasaloy CLI + module registry — the tool repo",
  "license": "MIT",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm run lint:types && pnpm run lint:code && pnpm run lint:css && pnpm run format:check",
    "lint:types": "oxlint -c oxlint.config.mjs --type-aware --deny-warnings packages/cli/src scripts",
    "lint:code": "oxlint -c oxlint.config.mjs --deny-warnings .",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix . && stylelint \"**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm run typecheck:scripts && turbo run typecheck",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "turbo run test",
    "cli": "node packages/cli/dist/index.js",
    "cli:dev": "pnpm --filter saasaloy dev",
    "cli:link": "pnpm --filter saasaloy build && pnpm add --global ./packages/cli",
    "cli:unlink": "pnpm rm --global saasaloy",
    "play:init": "pnpm --filter saasaloy build && node packages/cli/dist/index.js init .dev/playground --force --no-install && cp scripts/saasaloy-shim.sh .dev/playground/saasaloy && chmod +x .dev/playground/saasaloy && git init -q .dev/playground",
    "play:destroy": "rm -rf .dev/playground",
    "play:reset": "pnpm run play:destroy && pnpm run play:init",
    "play:watch": "node scripts/watch-template.ts",
    "deps:check": "node scripts/update-deps.ts --check",
    "deps:update": "node scripts/update-deps.ts",
    "deps:verify": "pnpm run play:init && pnpm -C .dev/playground install && pnpm -C .dev/playground build && node scripts/verify-css.ts && pnpm -C .dev/playground typecheck",
    "verify:preset": "node scripts/verify-preset.ts"
  },
  "devDependencies": {
    "@clack/prompts": "1.7.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "26.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "picocolors": "1.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "17.14.1",
    "stylelint-config-idiomatic-order": "10.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-prettier": "5.0.3",
    "turbo": "2.10.5",
    "typescript": "7.0.2",
    "ultracite": "7.10.1"
  }
}
