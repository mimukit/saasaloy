{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "billing-console",
  "type": "saasaloy:feature",
  "description": "A billing provider that runs the whole checkout flow with no network and no secret.",
  "stage": "money",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["billing"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "packages/billing/src/index.ts",
      "kind": "plugin-array",
      "exportName": "billing",
      "arrayProp": "providers",
      "call": "consoleBilling",
      "import": {
        "name": "consoleBilling",
        "from": "./providers/console"
      }
    }
  ],
  "files": [
    { "path": "files/console.ts", "target": "@billing/providers/console.ts" }
  ],
  "scaffolds": []
}
