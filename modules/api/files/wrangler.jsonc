{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  // Same port `vite dev` uses (see vite.config.ts), so `wrangler dev` is a drop-in
  // swap for the Vite loop — useful because Vite's dev middleware reflects an
  // `Access-Control-Allow-Origin` for every loopback origin, which masks the Worker's
  // own CORS allowlist. Test CORS against `wrangler dev`.
  "dev": {
    "port": 4000
  },
  // Workers Logs: what makes `console.*` output (everything `@repo/logger`'s console
  // provider writes) queryable in the dashboard, with fields indexed rather than
  // text-matched. On by default because a Worker you cannot see into is the expensive
  // kind. `head_sampling_rate` is the cost dial — 1 keeps every invocation, 0.1 keeps a
  // tenth; drop it per environment (`env.production.observability`) if a high-traffic
  // Worker's log volume starts to matter. Sampling is the platform's job, not the
  // logger's, which is why no module knob duplicates it.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
  // No bindings in the base `api` module. Capabilities and features that need a
  // D1 database, R2 bucket, KV namespace, or Queue patch this file to add their own
  // binding (via the jsonc-parser patch engine) — see the `saasaloy-api` skill.
}
