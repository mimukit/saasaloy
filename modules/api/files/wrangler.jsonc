{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  // Same port `vite dev` uses (see vite.config.ts), so `wrangler dev` is a drop-in
  // swap for the Vite loop — useful because Vite's dev middleware reflects an
  // `Access-Control-Allow-Origin` for every loopback origin, which masks the Worker's
  // own CORS allowlist. Test CORS against `wrangler dev`.
  "dev": {
    "port": 4000
  }
  // No bindings in the base `api` module. Capabilities and features that need a
  // D1 database, R2 bucket, KV namespace, or Queue patch this file to add their own
  // binding (via the jsonc-parser patch engine) — see the `saasaloy-api` skill.
}
