{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "api",
  "type": "saasaloy:capability",
  "dependsOn": ["logger", "logger-console"],
  "dependencies": [],
  "envVars": {
    "CORS_ORIGINS": "Comma-separated allowed origins for credentialed cross-origin requests (e.g. https://app.x.com). Falls back to localhost dev origins when unset."
  },
  "patches": [],
  "files": [],
  "scaffolds": [
    {
      "workspace": "apps/api",
      "aliases": { "@api": "apps/api/src" },
      "files": [
        { "path": "files/package.json", "target": "package.json" },
        { "path": "files/tsconfig.json", "target": "tsconfig.json" },
        { "path": "files/wrangler.jsonc", "target": "wrangler.jsonc" },
        { "path": "files/vite.config.ts", "target": "vite.config.ts" },
        { "path": "files/src/index.ts", "target": "src/index.ts" },
        { "path": "files/src/client.ts", "target": "src/client.ts" },
        {
          "path": "files/src/routes/health.ts",
          "target": "src/routes/health.ts"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-api"]
  }
}
