{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "api",
  "type": "saasaloy:capability",
  "description": "An apps/api Hono Worker on Cloudflare, registered as the @api alias, with structured logging.",
  "stage": "validate",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["logger", "logger-console"],
  "dependencies": [],
  "envVars": {
    "CORS_ORIGINS": "Required. Comma-separated allowed origins for credentialed cross-origin requests (e.g. https://app.x.com,https://admin.x.com). There is no localhost fallback: an origin outside this list gets no CORS headers. In dev, keep the localhost default here: pnpm env:setup runs pnpm dev:ports, which writes this checkout's real web, admin and app origins (localhost and DEV_HOST) into apps/api/.env.local, and that file wins. In production, list every deployed frontend (web, admin, app)."
  },
  "envServices": {
    "default": ["api"]
  },
  "devVars": {
    "CORS_ORIGINS": "http://localhost:3000,http://localhost:3001,http://localhost:3002"
  },
  "patches": [
    {
      "file": "packages/env/src/services.ts",
      "kind": "const-array",
      "constName": "SERVICES",
      "key": "name",
      "entry": {
        "name": "api",
        "file": "apps/api/.env",
        "environment": "dev",
        "omit": [],
        "devPort": 4000
      }
    },
    {
      "file": "packages/tooling/src/targets.ts",
      "kind": "const-array",
      "constName": "DEPLOY_TARGETS",
      "key": "service",
      "entry": {
        "service": "api",
        "order": 10
      }
    },
    {
      "file": "packages/tooling/src/targets.ts",
      "kind": "const-array",
      "constName": "SMOKE_CHECKS",
      "key": "id",
      "entry": {
        "id": "api-health",
        "service": "api",
        "path": "/health",
        "status": 200,
        "body": "\"ok\""
      }
    }
  ],
  "files": [],
  "scaffolds": [
    {
      "workspace": "apps/api",
      "aliases": {
        "@api": "apps/api/src"
      },
      "files": [
        {
          "path": "files/package.json",
          "target": "package.json"
        },
        {
          "path": "files/tsconfig.json",
          "target": "tsconfig.json"
        },
        {
          "path": "files/wrangler.jsonc",
          "target": "wrangler.jsonc"
        },
        {
          "path": "files/vite.config.ts",
          "target": "vite.config.ts"
        },
        {
          "path": "files/vitest.config.ts",
          "target": "vitest.config.ts"
        },
        {
          "path": "files/test/cloudflare-workers.ts",
          "target": "test/cloudflare-workers.ts"
        },
        {
          "path": "files/test/setup/.gitkeep",
          "target": "test/setup/.gitkeep"
        },
        {
          "path": "files/src/env.ts",
          "target": "src/env.ts"
        },
        {
          "path": "files/src/index.ts",
          "target": "src/index.ts"
        },
        {
          "path": "files/src/worker.ts",
          "target": "src/worker.ts"
        },
        {
          "path": "files/src/client.ts",
          "target": "src/client.ts"
        },
        {
          "path": "files/src/routes/health.ts",
          "target": "src/routes/health.ts"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-api"]
  }
}
