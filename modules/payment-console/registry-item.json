{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "payment-console",
  "type": "saasaloy:feature",
  "description": "A payment provider with a fake hosted checkout page for development, with no network and no secret.",
  "stage": "money",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["payment"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "packages/payment/src/index.ts",
      "kind": "plugin-array",
      "exportName": "payment",
      "arrayProp": "providers",
      "call": "consolePayment",
      "import": {
        "name": "consolePayment",
        "from": "./providers/console"
      }
    }
  ],
  "files": [
    { "path": "files/console.ts", "target": "@payment/providers/console.ts" },
    {
      "path": "files/console.vitest.ts",
      "target": "@payment/providers/console.test.ts",
      "when": { "testing": true }
    }
  ],
  "scaffolds": []
}
