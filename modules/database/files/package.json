    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.10",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
