{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "database",
  "type": "saasaloy:capability",
  "dependsOn": ["api"],
  "requiresOneOf": ["database-d1", "database-postgres"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "apps/api/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/db",
      "range": "workspace:*"
    }
  ],
  "files": [],
  "scaffolds": [
    {
      "workspace": "packages/db",
      "aliases": { "@db": "packages/db/src" },
      "files": [
        { "path": "files/package.json", "target": "package.json" },
        { "path": "files/tsconfig.json", "target": "tsconfig.json" },
        { "path": "files/vitest.config.ts", "target": "vitest.config.ts" },
        { "path": "files/src/schema.ts", "target": "src/schema.ts" },
        {
          "path": "files/src/schema/.gitkeep",
          "target": "src/schema/.gitkeep"
        },
        {
          "path": "files/src/repositories/.gitkeep",
          "target": "src/repositories/.gitkeep"
        },
        {
          "path": "files/src/seed/index.ts",
          "target": "src/seed/index.ts"
        },
        {
          "path": "files/src/seed/id.ts",
          "target": "src/seed/id.ts"
        },
        {
          "path": "files/src/seed/slice.ts",
          "target": "src/seed/slice.ts"
        },
        {
          "path": "files/src/seed/order.ts",
          "target": "src/seed/order.ts"
        },
        {
          "path": "files/src/seed/plan.ts",
          "target": "src/seed/plan.ts"
        },
        {
          "path": "files/src/seed/table.ts",
          "target": "src/seed/table.ts"
        },
        {
          "path": "files/src/seed/apply.ts",
          "target": "src/seed/apply.ts"
        },
        {
          "path": "files/src/seed/completeness.vitest.ts",
          "target": "src/seed/completeness.test.ts"
        },
        {
          "path": "files/src/seed/slices/.gitkeep",
          "target": "src/seed/slices/.gitkeep"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-database"]
  }
}
