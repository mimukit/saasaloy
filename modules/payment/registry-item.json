{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "payment",
  "type": "saasaloy:capability",
  "requires": {
    "saasaloy": ">=0.6.0"
  },
  "dependsOn": ["api", "database", "auth", "admin"],
  "dependencies": [],
  "envVars": {
    "PAYMENT_PROVIDER": "Which installed providers take payments, as a comma list in priority order: `console` (add payment-console), `manual` (add payment-manual), and later `sslcommerz`, `bkash`. `create({ method })` picks the first listed provider that offers the method. Always required: unset, empty or an unknown name throws when the client is built, so nothing takes real money by accident and nothing stops taking it silently.",
    "PAYMENT_APP_URL": "The origin of the app a hosted checkout returns the payer to, e.g. https://shop.x.com. `create` refuses a returnUrl on any other origin. Optional; when unset, only http://localhost origins pass, which is the dev default."
  },
  "envServices": {
    "default": ["api"]
  },
  "envOptional": ["PAYMENT_APP_URL"],
  "removeWarnings": [
    "The deployed payments, payment_events and payment_refunds tables survive this removal. They are the only record of manual payments, so export them before you run db:generate and apply the resulting drop migration.",
    "Removing this module does not refund or cancel anything at a payment gateway. Settle open payments in the vendor's own dashboard first."
  ],
  "patches": [
    {
      "file": "apps/api/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/payment",
      "range": "workspace:*"
    },
    {
      "file": "apps/api/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "drizzle-orm",
      "range": "0.45.3"
    },
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/payment",
      "call": "paymentRoute",
      "import": {
        "name": "paymentRoute",
        "from": "./routes/payment"
      }
    },
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/admin/payment",
      "call": "adminPayment",
      "import": {
        "name": "adminPayment",
        "from": "./routes/admin-payment"
      }
    },
    {
      "file": "apps/api/src/env.ts",
      "kind": "plugin-array",
      "exportName": "apiEnv",
      "arrayProp": "extends",
      "call": "paymentEnv",
      "import": {
        "name": "paymentEnv",
        "from": "@repo/payment/env-preset"
      }
    },
    {
      "file": "apps/admin/src/components/nav.ts",
      "kind": "nav-entry",
      "constName": "NAV_AREAS",
      "area": "/",
      "group": "Manage",
      "entry": {
        "to": "/payments",
        "label": "Payments"
      },
      "icon": {
        "name": "BanknoteIcon",
        "from": "lucide-react"
      }
    },
    {
      "file": "apps/admin/src/components/nav-counts.ts",
      "kind": "const-array",
      "constName": "NAV_COUNTS",
      "key": "to",
      "entry": {
        "to": "/payments",
        "path": "/admin/payment/review-count"
      }
    }
  ],
  "files": [
    {
      "path": "files/api/routes/payment.ts",
      "target": "@api/routes/payment.ts"
    },
    {
      "path": "files/api/routes/admin-payment.ts",
      "target": "@api/routes/admin-payment.ts"
    },
    {
      "path": "files/api/payment-store.ts",
      "target": "@api/payment-store.ts"
    },
    {
      "path": "files/db/schema/payment.sqlite.ts",
      "target": "@db/schema/payment.ts",
      "onlyWith": "database-d1"
    },
    {
      "path": "files/db/schema/payment.pg.ts",
      "target": "@db/schema/payment.ts",
      "onlyWith": "database-postgres"
    },
    {
      "path": "files/admin/routes/payments.tsx",
      "target": "@admin/routes/payments.tsx"
    },
    {
      "path": "files/db/seed/payments.ts",
      "target": "@db/seed/slices/payments.ts"
    },
    {
      "path": "files/db/seed/payment-events.ts",
      "target": "@db/seed/slices/payment-events.ts"
    },
    {
      "path": "files/db/seed/payment-refunds.ts",
      "target": "@db/seed/slices/payment-refunds.ts"
    }
  ],
  "scaffolds": [
    {
      "workspace": "packages/payment",
      "aliases": {
        "@payment": "packages/payment/src"
      },
      "files": [
        {
          "path": "files/package.json",
          "target": "package.json"
        },
        {
          "path": "files/tsconfig.json",
          "target": "tsconfig.json"
        },
        {
          "path": "files/src/index.ts",
          "target": "src/index.ts"
        },
        {
          "path": "files/src/define.ts",
          "target": "src/define.ts"
        },
        {
          "path": "files/src/provider.ts",
          "target": "src/provider.ts"
        },
        {
          "path": "files/src/store.ts",
          "target": "src/store.ts"
        },
        {
          "path": "files/src/env-preset.ts",
          "target": "src/env-preset.ts"
        },
        {
          "path": "files/src/providers/.gitkeep",
          "target": "src/providers/.gitkeep"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-payment"]
  }
}
