{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "storage-memory",
  "type": "saasaloy:feature",
  "description": "A storage provider that keeps objects in memory, for local development and tests.",
  "stage": "scale",
  "needs": [],
  "requires": { "saasaloy": ">=0.10.0" },
  "dependsOn": ["storage"],
  "dependencies": [],
  "envVars": {},
  "files": [
    { "path": "files/memory.ts", "target": "@storage/providers/memory.ts" }
  ],
  "entries": [
    {
      "table": "storage.providers",
      "call": "memory",
      "import": {
        "name": "memory",
        "from": "./providers/memory"
      }
    }
  ],
  "scaffolds": []
}
