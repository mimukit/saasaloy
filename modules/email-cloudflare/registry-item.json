{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "email-cloudflare",
  "type": "saasaloy:feature",
  "description": "An email provider on Cloudflare Email Sending, which needs a paid Workers plan and an onboarded domain.",
  "stage": "mvp",
  "needs": ["cloudflare-paid", "domain"],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["email"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "send_email",
      "entry": {
        "name": "EMAIL",
        "remote": false
      },
      "matchOn": "name"
    },
    {
      "file": "packages/email/src/index.ts",
      "kind": "plugin-array",
      "exportName": "email",
      "arrayProp": "providers",
      "call": "cloudflare",
      "import": {
        "name": "cloudflare",
        "from": "./providers/cloudflare"
      }
    },
    {
      "file": "packages/email/package.json",
      "kind": "package-json-dependency",
      "section": "devDependencies",
      "name": "@cloudflare/workers-types",
      "range": "5.20261001.1"
    }
  ],
  "files": [
    {
      "path": "files/cloudflare.ts",
      "target": "@email/providers/cloudflare.ts"
    }
  ],
  "scaffolds": []
}
