{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "email-console",
  "type": "saasaloy:feature",
  "description": "An email provider that logs each message instead of sending it, with no plan, domain or key.",
  "stage": "mvp",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["email"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "packages/email/src/index.ts",
      "kind": "plugin-array",
      "exportName": "email",
      "arrayProp": "providers",
      "call": "consoleEmail",
      "import": {
        "name": "consoleEmail",
        "from": "./providers/console"
      }
    }
  ],
  "files": [
    { "path": "files/console.ts", "target": "@email/providers/console.ts" }
  ],
  "scaffolds": []
}
