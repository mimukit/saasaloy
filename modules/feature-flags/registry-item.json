{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "feature-flags",
  "type": "saasaloy:feature",
  "description": "Typed feature flags with per-tenant overrides, percentage rollouts, kill switches and a flags admin screen.",
  "stage": "scale",
  "needs": [],
  "requires": { "saasaloy": ">=0.10.0" },
  "dependsOn": ["api", "database", "validators", "auth", "admin", "kv"],
  "dependencies": [],
  "removeWarnings": [
    "The deployed feature_flags and feature_flag_overrides tables survive this removal. Run db:generate and review the resulting drop migration before you apply it.",
    "The published flag documents survive it too. They have no TTL, so `flags:v1:global` and every `flags:v1:t:<tenantId>` stay in the KV namespace until you delete them with `wrangler kv key delete`."
  ],
  "patches": [
    {
      "file": "apps/api/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/feature-flags",
      "range": "workspace:*"
    },
    {
      "file": "apps/admin/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/feature-flags",
      "range": "workspace:*"
    }
  ],
  "entries": [
    {
      "table": "config.sections",
      "call": "featureFlagsConfig",
      "import": {
        "name": "featureFlagsConfig",
        "from": "./sections/feature-flags"
      }
    },
    {
      "table": "api.routes",
      "path": "/admin/flags",
      "call": "featureFlags",
      "import": {
        "name": "featureFlags",
        "from": "./routes/feature-flags"
      }
    },
    {
      "table": "admin.nav",
      "area": "/",
      "group": "Manage",
      "entry": {
        "to": "/flags",
        "label": "Flags"
      },
      "import": {
        "name": "FlagIcon",
        "from": "lucide-react"
      }
    },
    {
      "table": "audit.actions",
      "call": "featureFlagsAuditActions",
      "import": {
        "name": "featureFlagsAuditActions",
        "from": "../audit/feature-flags"
      }
    }
  ],
  "files": [
    {
      "path": "files/config/feature-flags.ts",
      "target": "@config/sections/feature-flags.ts"
    },
    {
      "path": "files/api/audit/feature-flags.ts",
      "target": "@api/audit/feature-flags.ts"
    },
    {
      "path": "files/api/routes/feature-flags.ts",
      "target": "@api/routes/feature-flags.ts"
    },
    {
      "path": "files/api/lib/flags.ts",
      "target": "@api/lib/flags.ts"
    },
    {
      "path": "files/api/middleware/maintenance.ts",
      "target": "@api/middleware/maintenance.ts"
    },
    {
      "path": "files/db/schema/feature-flags.ts",
      "target": "@db/schema/feature-flags.ts"
    },
    {
      "path": "files/db/repositories/feature-flags.ts",
      "target": "@db/repositories/feature-flags.ts"
    },
    {
      "path": "files/validators/feature-flags.ts",
      "target": "@validators/feature-flags.ts"
    },
    {
      "path": "files/ui/blocks/admin/feature-flags.tsx",
      "target": "@ui/blocks/admin/feature-flags.tsx"
    },
    {
      "path": "files/admin/routes/flags.tsx",
      "target": "@admin/routes/flags.tsx"
    },
    {
      "path": "files/db/seed/feature-flags.ts",
      "target": "@db/seed/slices/feature-flags.ts"
    },
    {
      "path": "files/db/seed/feature-flag-overrides.ts",
      "target": "@db/seed/slices/feature-flag-overrides.ts"
    },
    {
      "path": "files/db/column-classes/feature-flag-overrides.ts",
      "target": "@db/column-classes/feature-flag-overrides.ts"
    },
    {
      "path": "files/db/column-classes/feature-flags.ts",
      "target": "@db/column-classes/feature-flags.ts"
    }
  ],
  "scaffolds": [
    {
      "workspace": "packages/feature-flags",
      "aliases": {
        "@flags": "packages/feature-flags/src"
      },
      "files": [
        {
          "path": "files/package.json",
          "target": "package.json"
        },
        {
          "path": "files/tsconfig.json",
          "target": "tsconfig.json"
        },
        {
          "path": "files/src/index.ts",
          "target": "src/index.ts"
        },
        {
          "path": "files/src/define.ts",
          "target": "src/define.ts"
        },
        {
          "path": "files/src/document.ts",
          "target": "src/document.ts"
        },
        {
          "path": "files/src/cache.ts",
          "target": "src/cache.ts"
        },
        {
          "path": "files/src/hash.ts",
          "target": "src/hash.ts"
        },
        {
          "path": "files/src/source.ts",
          "target": "src/source.ts"
        },
        {
          "path": "files/src/flags/system.ts",
          "target": "src/flags/system.ts"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-feature-flags"]
  }
}
