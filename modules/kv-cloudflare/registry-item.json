{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "kv-cloudflare",
  "type": "saasaloy:feature",
  "description": "A kv provider on Workers KV, with the KV namespace and ratelimits bindings.",
  "stage": "scale",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["kv"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "kv_namespaces",
      "entry": {
        "binding": "KV"
      },
      "matchOn": "binding"
    },
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "ratelimits",
      "entry": {
        "name": "RL_STRICT",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 10 }
      },
      "matchOn": "name"
    },
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "ratelimits",
      "entry": {
        "name": "RL_DEFAULT",
        "namespace_id": "1002",
        "simple": { "limit": 100, "period": 60 }
      },
      "matchOn": "name"
    },
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "ratelimits",
      "entry": {
        "name": "RL_LOOSE",
        "namespace_id": "1003",
        "simple": { "limit": 1000, "period": 60 }
      },
      "matchOn": "name"
    },
    {
      "file": "packages/kv/src/index.ts",
      "kind": "plugin-array",
      "exportName": "kv",
      "arrayProp": "providers",
      "call": "cloudflare",
      "import": {
        "name": "cloudflare",
        "from": "./providers/cloudflare"
      }
    },
    {
      "file": "packages/kv/package.json",
      "kind": "package-json-dependency",
      "section": "devDependencies",
      "name": "@cloudflare/workers-types",
      "range": "5.20261001.1"
    }
  ],
  "files": [
    {
      "path": "files/cloudflare.ts",
      "target": "@kv/providers/cloudflare.ts"
    },
    {
      "path": "files/cloudflare.vitest.ts",
      "target": "@kv/providers/cloudflare.test.ts",
      "when": { "testing": true }
    }
  ],
  "scaffolds": []
}
