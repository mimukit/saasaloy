{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "compatibility_date": "2026-07-21",
  // Pure static site: serve Vite's build output as Workers static assets, no Worker code.
  // `single-page-application` is what makes client-side routing survive a hard reload —
  // without it, a request for /sign-in returns a 404 because no such file exists in dist/.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // No bindings. The customer app is a browser bundle: it reaches the database and the
  // session through apps/api over HTTP, never through a binding of its own.
}
