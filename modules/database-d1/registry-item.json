{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "database-d1",
  "type": "saasaloy:feature",
  "dependsOn": ["database"],
  "conflictsWith": ["database-postgres"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "d1_databases",
      "entry": {
        "binding": "DB",
        "database_name": "app-db",
        "database_id": "local",
        "migrations_dir": "../../packages/db/migrations"
      }
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:migrate:local",
      "value": "wrangler d1 migrations apply DB --local --config ../../apps/api/wrangler.jsonc --persist-to ../../apps/api/.wrangler/state"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:migrate:prod",
      "value": "wrangler d1 migrations apply DB --remote --config ../../apps/api/wrangler.jsonc"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:setup",
      "value": "node scripts/setup.ts"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:status",
      "value": "node scripts/status.ts"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:drop",
      "value": "node scripts/drop.ts"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:setup",
      "value": "pnpm --filter @repo/db db:setup"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:status",
      "value": "pnpm --filter @repo/db db:status"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:drop",
      "value": "pnpm --filter @repo/db db:drop"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-dependency",
      "section": "devDependencies",
      "name": "@cloudflare/workers-types",
      "range": "5.20260906.1"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-dependency",
      "section": "devDependencies",
      "name": "wrangler",
      "range": "4.129.0"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-dependency",
      "section": "devDependencies",
      "name": "@types/node",
      "range": "26.4.1"
    }
  ],
  "files": [
    {
      "path": "files/src/client.ts",
      "target": "@db/client.ts"
    }
  ],
  "scaffolds": [
    {
      "workspace": "packages/db",
      "files": [
        {
          "path": "files/drizzle.config.ts",
          "target": "drizzle.config.ts"
        },
        {
          "path": "files/tsconfig.json",
          "target": "tsconfig.json"
        },
        {
          "path": "files/scripts/setup.ts",
          "target": "scripts/setup.ts"
        },
        {
          "path": "files/scripts/status.ts",
          "target": "scripts/status.ts"
        },
        {
          "path": "files/scripts/drop.ts",
          "target": "scripts/drop.ts"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-database-d1"]
  }
}
