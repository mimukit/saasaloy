      "name": "e2e",
      "value": "pnpm --filter @repo/e2e e2e"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "e2e:install",
      "value": "pnpm --filter @repo/e2e e2e:install"
    }
  ],
  "files": [],
  "scaffolds": [
    {
      "workspace": "packages/e2e",
