{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "teams",
  "type": "saasaloy:feature",
  "description": "Organizations, memberships, roles and copy-ID invitations on Better Auth, plus a site-admin Teams screen.",
  "stage": "teams",
  "needs": [],
  "requires": { "saasaloy": ">=0.10.0" },
  "dependsOn": ["api", "database", "auth", "admin"],
  "dependencies": [],
  "envVars": {},
  "removeWarnings": [
    "The deployed organizations, members, invitations, and organization_roles tables survive this removal. Run db:generate and review the resulting drop migration before you apply it."
  ],
  "files": [
    {
      "path": "files/db/schema/teams.ts",
      "target": "@db/schema/teams.ts"
    },
    {
      "path": "files/auth/access.ts",
      "target": "@auth/access.ts"
    },
    {
      "path": "files/auth/plugins/organization.ts",
      "target": "@auth/plugins/organization.ts"
    },
    {
      "path": "files/auth/plugins/organization-client.ts",
      "target": "@auth/plugins/organization-client.ts"
    },
    {
      "path": "files/auth/permission-rules.ts",
      "target": "@auth/permission-rules.ts"
    },
    {
      "path": "files/auth/plugins/role-lock.ts",
      "target": "@auth/plugins/role-lock.ts"
    },
    {
      "path": "files/admin/routes/teams.tsx",
      "target": "@admin/routes/teams.tsx"
    },
    {
      "path": "files/admin/components/organization-create-form.tsx",
      "target": "@admin/components/organization-create-form.tsx"
    },
    {
      "path": "files/admin/components/organization-workspace.tsx",
      "target": "@admin/components/organization-workspace.tsx"
    },
    {
      "path": "files/db/seed/organizations.ts",
      "target": "@db/seed/slices/organizations.ts"
    },
    {
      "path": "files/db/seed/members.ts",
      "target": "@db/seed/slices/members.ts"
    },
    {
      "path": "files/db/seed/invitations.ts",
      "target": "@db/seed/slices/invitations.ts"
    },
    {
      "path": "files/db/seed/organization-roles.ts",
      "target": "@db/seed/slices/organization-roles.ts"
    },
    {
      "path": "files/db/column-classes/invitations.ts",
      "target": "@db/column-classes/invitations.ts"
    },
    {
      "path": "files/db/column-classes/members.ts",
      "target": "@db/column-classes/members.ts"
    },
    {
      "path": "files/db/column-classes/organization-roles.ts",
      "target": "@db/column-classes/organization-roles.ts"
    },
    {
      "path": "files/db/column-classes/organizations.ts",
      "target": "@db/column-classes/organizations.ts"
    }
  ],
  "entries": [
    {
      "table": "auth.plugins",
      "call": "organizationPlugin",
      "import": {
        "name": "organizationPlugin",
        "from": "./plugins/organization"
      }
    },
    {
      "table": "adminAuth.plugins",
      "call": "organizationPlugin",
      "import": {
        "name": "organizationPlugin",
        "from": "./plugins/organization"
      }
    },
    {
      "table": "client.plugins",
      "call": "organizationClientPlugin",
      "import": {
        "name": "organizationClientPlugin",
        "from": "./plugins/organization-client"
      }
    },
    {
      "table": "auth.plugins",
      "call": "roleLockGuard",
      "import": {
        "name": "roleLockGuard",
        "from": "./plugins/role-lock"
      }
    },
    {
      "table": "adminAuth.plugins",
      "call": "roleLockGuard",
      "import": {
        "name": "roleLockGuard",
        "from": "./plugins/role-lock"
      }
    },
    {
      "table": "adminClient.plugins",
      "call": "organizationClientPlugin",
      "import": {
        "name": "organizationClientPlugin",
        "from": "./plugins/organization-client"
      }
    },
    {
      "table": "admin.nav",
      "area": "/",
      "group": "Manage",
      "entry": {
        "to": "/teams",
        "label": "Teams"
      },
      "import": {
        "name": "UsersRoundIcon",
        "from": "lucide-react"
      }
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-teams"]
  }
}
