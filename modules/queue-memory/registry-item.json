{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "queue-memory",
  "type": "saasaloy:feature",
  "description": "A queue provider that runs jobs in-process, with no binding and no env var.",
  "stage": "scale",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["queue"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "packages/queue/src/index.ts",
      "kind": "plugin-array",
      "exportName": "queue",
      "arrayProp": "providers",
      "call": "memory",
      "import": {
        "name": "memory",
        "from": "./providers/memory"
      }
    }
  ],
  "files": [
    { "path": "files/memory.ts", "target": "@queue/providers/memory.ts" }
  ],
  "scaffolds": []
}
