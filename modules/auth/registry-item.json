{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "auth",
  "type": "saasaloy:capability",
  "description": "Sign-in and sessions with Better Auth in a packages/auth workspace, on api and database.",
  "stage": "mvp",
  "needs": [],
  "requires": { "saasaloy": ">=0.8.0" },
  "dependsOn": ["api", "database"],
  "dependencies": [],
  "envVars": {
    "BETTER_AUTH_SECRET": "Workers secret used to sign sessions. Required: auth throws while the Worker initializes when it is unset, unless BETTER_AUTH_URL names a loopback host.",
    "BETTER_AUTH_URL": "The API's own origin (e.g. https://api.x.com, or http://localhost:4000 locally). Used as the auth baseURL, to derive the cookie domain, and to allow the keyless local dev loop. When unset there is no loopback exception, so BETTER_AUTH_SECRET becomes mandatory, and the session cookie stays host-only unless COOKIE_DOMAIN sets it.\nFIRST USER WINS: the first account to sign up on an empty users table gets role 'superadmin', the role above 'admin'. Client sign-up at /auth is open, so once this origin is public anyone who reaches /auth/sign-up/email before you becomes the superadmin. Sign up yourself as soon as the API answers, then sign in on the admin app with the same email and password. Run /saasaloy-auth for the recovery SQL if somebody else got there first.",
    "COOKIE_DOMAIN": "Optional. Explicit cookie domain (e.g. .x.com) for cross-subdomain sessions. Derived from BETTER_AUTH_URL when unset. It scopes both session cookies, client.session_token (signed in at /auth) and admin.session_token (signed in at /admin/auth); their names keep the two sessions apart."
  },
  "envServices": {
    "default": ["api"]
  },
  "envOptional": ["BETTER_AUTH_SECRET", "COOKIE_DOMAIN"],
  "devVars": {
    "BETTER_AUTH_URL": "http://localhost:4000"
  },
  "patches": [
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "base",
      "path": "/auth",
      "call": "authRoute",
      "import": {
        "name": "authRoute",
        "from": "./routes/auth"
      }
    },
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "base",
      "path": "/admin/auth",
      "call": "adminAuthRoute",
      "import": {
        "name": "adminAuthRoute",
        "from": "./routes/auth"
      }
    },
    {
      "file": "apps/api/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/auth",
      "range": "workspace:*"
    },
    {
      "file": "packages/config/src/sections.ts",
      "kind": "plugin-array",
      "exportName": "sections",
      "arrayProp": "sections",
      "call": "authConfig",
      "import": {
        "name": "authConfig",
        "from": "./sections/auth"
      }
    },
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "compatibility_flags",
      "entry": "nodejs_compat"
    },
    {
      "file": "apps/api/src/env.ts",
      "kind": "plugin-array",
      "exportName": "apiEnv",
      "arrayProp": "extends",
      "call": "authEnv",
      "import": {
        "name": "authEnv",
        "from": "@repo/auth/env-preset"
      }
    },
    {
      "file": "packages/auth/src/auth.ts",
      "kind": "plugin-array",
      "exportName": "auth",
      "arrayProp": "plugins",
      "call": "resetPasswordMail",
      "import": {
        "name": "resetPasswordMail",
        "from": "./plugins/reset-password-mail"
      },
      "when": { "installed": ["email"] }
    },
    {
      "file": "packages/auth/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/email",
      "range": "workspace:*",
      "when": { "installed": ["email"] }
    }
  ],
  "files": [
    {
      "path": "files/api/routes/auth.ts",
      "target": "@api/routes/auth.ts"
    },
    {
      "path": "files/api/routes/auth.vitest.ts",
      "target": "@api/routes/auth.test.ts",
      "when": { "testing": true }
    },
    {
      "path": "files/api/routes/reset-password.vitest.ts",
      "target": "@api/routes/reset-password.test.ts",
      "when": { "testing": true, "installed": ["email"] }
    },
    {
      "path": "files/config/auth.ts",
      "target": "@config/sections/auth.ts"
    },
    {
      "path": "files/db/schema/auth.sqlite.ts",
      "target": "@db/schema/auth.ts",
      "onlyWith": "database-d1"
    },
    {
      "path": "files/db/schema/auth.pg.ts",
      "target": "@db/schema/auth.ts",
      "onlyWith": "database-postgres"
    },
    {
      "path": "files/db/repositories/site-roles.ts",
      "target": "@db/repositories/site-roles.ts"
    },
    {
      "path": "files/db/seed/users.ts",
      "target": "@db/seed/slices/users.ts"
    },
    {
      "path": "files/db/seed/accounts.ts",
      "target": "@db/seed/slices/accounts.ts"
    },
    {
      "path": "files/db/seed/sessions.ts",
      "target": "@db/seed/slices/sessions.ts"
    },
    {
      "path": "files/db/seed/verifications.ts",
      "target": "@db/seed/slices/verifications.ts"
    },
    {
      "path": "files/ui/blocks/auth/auth-card.tsx",
      "target": "@ui/blocks/auth/auth-card.tsx",
      "when": { "installed": ["shell"] }
    },
    {
      "path": "files/ui/blocks/auth/sign-in.tsx",
      "target": "@ui/blocks/auth/sign-in.tsx",
      "when": { "installed": ["shell"] }
    },
    {
      "path": "files/ui/blocks/auth/sign-up.tsx",
      "target": "@ui/blocks/auth/sign-up.tsx",
      "when": { "installed": ["shell"] }
    },
    {
      "path": "files/email/templates/reset-password.ts",
      "target": "@email/templates/reset-password.ts",
      "when": { "installed": ["email"] }
    }
  ],
  "scaffolds": [
    {
      "workspace": "packages/auth",
      "aliases": {
        "@auth": "packages/auth/src"
      },
      "files": [
        {
          "path": "files/package.json",
          "target": "package.json"
        },
        {
          "path": "files/tsconfig.json",
          "target": "tsconfig.json"
        },
        {
          "path": "files/src/auth.ts",
          "target": "src/auth.ts",
          "untested": "Assembles the Better Auth instance; auth.test.ts exercises it through the api."
        },
        {
          "path": "files/src/audience-rank.vitest.ts",
          "target": "src/audience-rank.test.ts",
          "when": { "testing": true }
        },
        {
          "path": "files/src/authorize.ts",
          "target": "src/authorize.ts",
          "untested": "Tested through audience-rank.test.ts and server.test.ts, which import it."
        },
        {
          "path": "files/src/db-scope.ts",
          "target": "src/db-scope.ts"
        },
        {
          "path": "files/src/db-scope.vitest.ts",
          "target": "src/db-scope.test.ts",
          "when": { "testing": true }
        },
        {
          "path": "files/src/db-provider.d1.ts",
          "target": "src/db-provider.ts",
          "onlyWith": "database-d1",
          "untested": "Hands the D1 client to the adapter; wiring the route tests cover."
        },
        {
          "path": "files/src/db-provider.pg.ts",
          "target": "src/db-provider.ts",
          "onlyWith": "database-postgres",
          "untested": "Hands the Postgres client to the adapter; wiring the route tests cover."
        },
        {
          "path": "files/src/env.ts",
          "target": "src/env.ts"
        },
        {
          "path": "files/src/env.vitest.ts",
          "target": "src/env.test.ts",
          "when": { "testing": true }
        },
        {
          "path": "files/src/scoped-adapter.ts",
          "target": "src/scoped-adapter.ts",
          "untested": "Wraps the Drizzle adapter in the request scope; db-scope.test.ts and the route tests cover it."
        },
        {
          "path": "files/src/plugins/audience.ts",
          "target": "src/plugins/audience.ts",
          "untested": "A Better Auth plugin; auth.test.ts covers the cross-audience sign-in it refuses."
        },
        {
          "path": "files/src/plugins/client-admin-guard.ts",
          "target": "src/plugins/client-admin-guard.ts",
          "untested": "A Better Auth plugin; auth.test.ts covers the refusal it adds."
        },
        {
          "path": "files/src/plugins/rank-guard.ts",
          "target": "src/plugins/rank-guard.ts",
          "untested": "A Better Auth plugin over rankDenial, which audience-rank.test.ts tests."
        },
        {
          "path": "files/src/plugins/reset-password-mail.ts",
          "target": "src/plugins/reset-password-mail.ts",
          "when": { "installed": ["email"] },
          "untested": "A Better Auth plugin; reset-password.test.ts covers the mail it sends."
        },
        {
          "path": "files/src/server.ts",
          "target": "src/server.ts"
        },
        {
          "path": "files/src/server.vitest.ts",
          "target": "src/server.test.ts",
          "when": { "testing": true }
        },
        {
          "path": "files/src/client.ts",
          "target": "src/client.ts",
          "untested": "Builds the Better Auth browser clients; wiring with no rule of its own."
        },
        {
          "path": "files/src/env-preset.ts",
          "target": "src/env-preset.ts"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-auth"]
  }
}
