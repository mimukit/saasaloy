{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "queue-cloudflare",
  "type": "saasaloy:feature",
  "description": "A queue provider on Cloudflare Queues, which needs a paid Workers plan.",
  "stage": "scale",
  "needs": ["cloudflare-paid"],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["queue"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "queues.producers",
      "entry": {
        "binding": "JOBS",
        "queue": "{{PROJECT_NAME}}-jobs"
      }
    },
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "queues.producers",
      "entry": {
        "binding": "JOBS_DLQ",
        "queue": "{{PROJECT_NAME}}-jobs-dlq"
      }
    },
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "queues.consumers",
      "entry": {
        "queue": "{{PROJECT_NAME}}-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "{{PROJECT_NAME}}-jobs-dlq"
      },
      "matchOn": "queue"
    },
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "triggers.crons",
      "entry": "* * * * *"
    },
    {
      "file": "packages/queue/src/index.ts",
      "kind": "plugin-array",
      "exportName": "queue",
      "arrayProp": "providers",
      "call": "cloudflare",
      "import": {
        "name": "cloudflare",
        "from": "./providers/cloudflare"
      }
    },
    {
      "file": "apps/api/src/worker.ts",
      "kind": "plugin-array",
      "exportName": "worker",
      "arrayProp": "handlers",
      "call": "cloudflareQueueHandlers",
      "import": {
        "name": "cloudflareQueueHandlers",
        "from": "@repo/queue/providers/cloudflare"
      }
    }
  ],
  "files": [
    {
      "path": "files/cloudflare.ts",
      "target": "@queue/providers/cloudflare.ts"
    }
  ],
  "scaffolds": []
}
