{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "sms",
  "type": "saasaloy:capability",
  "description": "A packages/sms workspace with the provider interface and segment counting; add one sms provider.",
  "stage": "scale",
  "needs": [],
  "requires": {
    "saasaloy": ">=0.7.0"
  },
  "dependsOn": ["api"],
  "dependencies": [],
  "envVars": {
    "SMS_PROVIDER": "Which installed provider sends: `console` (add sms-console) or `khudebarta` (add sms-khudebarta). Always required — there is no default, so nothing sends by accident and nothing stops sending silently.",
    "SMS_FROM": "Default sender for messages that don't carry their own `from` — an E.164 number, a short code, or an alphanumeric sender id, whichever the selected provider is allowed to send from. Optional: a provider routing through a pool or a messaging service assigns the sender itself. When it is unset and the message carries no `from`, a provider that requires a sender rejects the send with `invalid_message`."
  },
  "envServices": {
    "default": ["api"]
  },
  "envOptional": ["SMS_FROM"],
  "patches": [
    {
      "file": "apps/api/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/sms",
      "range": "workspace:*"
    },
    {
      "file": "apps/api/src/env.ts",
      "kind": "plugin-array",
      "exportName": "apiEnv",
      "arrayProp": "extends",
      "call": "smsEnv",
      "import": {
        "name": "smsEnv",
        "from": "@repo/sms/env-preset"
      }
    },
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/admin/sms",
      "call": "adminSms",
      "import": {
        "name": "adminSms",
        "from": "./routes/admin-sms"
      },
      "when": {
        "installed": ["admin", "database"]
      }
    },
    {
      "file": "apps/admin/src/components/nav.ts",
      "kind": "nav-entry",
      "constName": "NAV_AREAS",
      "area": "/",
      "group": "Manage",
      "entry": {
        "to": "/sms",
        "label": "SMS"
      },
      "icon": {
        "name": "MessageSquareTextIcon",
        "from": "lucide-react"
      },
      "when": {
        "installed": ["admin", "database"]
      }
    }
  ],
  "files": [
    {
      "path": "files/db/schema/sms-messages.sqlite.ts",
      "target": "@db/schema/sms-messages.ts",
      "onlyWith": "database-d1",
      "when": {
        "installed": ["database"]
      }
    },
    {
      "path": "files/db/schema/sms-messages.pg.ts",
      "target": "@db/schema/sms-messages.ts",
      "onlyWith": "database-postgres",
      "when": {
        "installed": ["database"]
      }
    },
    {
      "path": "files/db/repositories/sms-messages.ts",
      "target": "@db/repositories/sms-messages.ts",
      "when": {
        "installed": ["database"]
      }
    },
    {
      "path": "files/db/seed/sms-messages.ts",
      "target": "@db/seed/slices/sms-messages.ts",
      "when": {
        "installed": ["database"]
      }
    },
    {
      "path": "files/api/routes/admin-sms.ts",
      "target": "@api/routes/admin-sms.ts",
      "when": {
        "installed": ["admin", "database"]
      }
    },
    {
      "path": "files/api/routes/admin-sms.vitest.ts",
      "target": "@api/routes/admin-sms.test.ts",
      "when": {
        "testing": true,
        "installed": ["admin", "database"]
      }
    },
    {
      "path": "files/admin/routes/sms.tsx",
      "target": "@admin/routes/sms.tsx",
      "when": {
        "installed": ["admin", "database"]
      }
    }
  ],
  "scaffolds": [
    {
      "workspace": "packages/sms",
      "aliases": {
        "@sms": "packages/sms/src"
      },
      "files": [
        {
          "path": "files/package.json",
          "target": "package.json"
        },
        {
          "path": "files/tsconfig.json",
          "target": "tsconfig.json"
        },
        {
          "path": "files/src/index.ts",
          "target": "src/index.ts"
        },
        {
          "path": "files/src/define.ts",
          "target": "src/define.ts"
        },
        {
          "path": "files/src/mask-codes.ts",
          "target": "src/mask-codes.ts"
        },
        {
          "path": "files/src/provider.ts",
          "target": "src/provider.ts"
        },
        {
          "path": "files/src/segments.ts",
          "target": "src/segments.ts"
        },
        {
          "path": "files/src/templates/verification-code.ts",
          "target": "src/templates/verification-code.ts"
        },
        {
          "path": "files/src/providers/.gitkeep",
          "target": "src/providers/.gitkeep"
        },
        {
          "path": "files/src/env-preset.ts",
          "target": "src/env-preset.ts"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-sms"]
  },
  "removeWarnings": [
    "The deployed sms_messages table survives this removal. Run db:generate and review the resulting drop migration before you apply it."
  ]
}
