{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "env-infisical",
  "type": "saasaloy:feature",
  "description": "Infisical as a value source for pnpm env:setup and pnpm deploy:production; needs an Infisical account.",
  "stage": "scale",
  "needs": ["vendor-account"],
  "requires": { "saasaloy": ">=0.10.0" },
  "dependsOn": [],
  "dependencies": [],
  "envVars": {},
  "files": [
    {
      "path": "files/infisical.ts",
      "target": "@env/providers/infisical.ts"
    }
  ],
  "entries": [
    {
      "table": "env.sources",
      "call": "infisical",
      "import": {
        "name": "infisical",
        "from": "./providers/infisical.ts"
      }
    }
  ],
  "scaffolds": [],
  "agent": {
    "skills": ["skills/saasaloy-env-infisical"]
  }
}
