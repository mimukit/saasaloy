{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "admin",
  "type": "saasaloy:capability",
  "description": "An apps/admin TanStack Router SPA behind the auth session, for the site's staff.",
  "stage": "mvp",
  "needs": [],
  "requires": {
    "saasaloy": ">=0.9.0"
  },
  "dependsOn": ["api", "database", "auth", "shell"],
  "dependencies": [],
  "envVars": {
    "PUBLIC_API_URL": "Origin the admin SPA calls for api and auth requests (e.g. https://api.x.com). Falls back to http://localhost:4000 in dev. The `PUBLIC_` prefix is what vite.config.ts exposes to the browser bundle."
  },
  "envServices": {
    "default": ["admin"]
  },
  "removeWarnings": [
    "The deployed audit_events table survives this removal. It is the only record of which staff member changed what, so export it before you run db:generate and apply the resulting drop migration."
  ],
  "patches": [
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/admin",
      "call": "adminUsers",
      "import": {
        "name": "adminUsers",
        "from": "./routes/admin-users"
      }
    },
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/admin/members",
      "call": "adminMembers",
      "import": {
        "name": "adminMembers",
        "from": "./routes/admin-members"
      }
    },
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/admin/audit-events",
      "call": "adminAudit",
      "import": {
        "name": "adminAudit",
        "from": "./routes/admin-audit"
      }
    },
    {
      "file": "packages/env/src/services.ts",
      "kind": "const-array",
      "constName": "SERVICES",
      "key": "name",
      "entry": {
        "name": "admin",
        "file": "apps/admin/.env",
        "environment": "dev",
        "omit": []
      }
    },
    {
      "file": "packages/tooling/src/targets.ts",
      "kind": "const-array",
      "constName": "DEPLOY_TARGETS",
      "key": "service",
      "entry": {
        "service": "admin",
        "order": 20
      }
    },
    {
      "file": "packages/tooling/src/targets.ts",
      "kind": "const-array",
      "constName": "SMOKE_CHECKS",
      "key": "id",
      "entry": {
        "id": "admin-home",
        "service": "admin",
        "path": "/",
        "status": 200
      }
    },
    {
      "file": "apps/admin/src/components/shell-extensions.ts",
      "kind": "plugin-array",
      "exportName": "shellExtensions",
      "arrayProp": "extensions",
      "call": "commandExtension",
      "import": {
        "name": "commandExtension",
        "from": "@repo/ui/containers/command/command-root"
      },
      "when": {
        "installed": ["command"]
      }
    },
    {
      "file": "apps/api/src/lib/audit-actions.ts",
      "kind": "plugin-array",
      "exportName": "AUDIT_ACTIONS",
      "arrayProp": "actions",
      "call": "adminAuditActions",
      "import": {
        "name": "adminAuditActions",
        "from": "../audit/admin"
      }
    }
  ],
  "files": [
    {
      "path": "files/api/routes/admin-users.ts",
      "target": "@api/routes/admin-users.ts"
    },
    {
      "path": "files/api/routes/admin-users.vitest.ts",
      "target": "@api/routes/admin-users.test.ts",
      "when": { "testing": true }
    },
    {
      "path": "files/api/routes/admin-gate.vitest.ts",
      "target": "@api/routes/admin-gate.test.ts",
      "when": { "testing": true }
    },
    {
      "path": "files/api/lib/admin-write.ts",
      "target": "@api/lib/admin-write.ts"
    },
    {
      "path": "files/api/lib/changed-fields.ts",
      "target": "@api/lib/changed-fields.ts"
    },
    {
      "path": "files/api/lib/audit-actions.ts",
      "target": "@api/lib/audit-actions.ts"
    },
    {
      "path": "files/api/audit/admin.ts",
      "target": "@api/audit/admin.ts"
    },
    {
      "path": "files/api/routes/audit-coverage.vitest.ts",
      "target": "@api/routes/audit-coverage.test.ts",
      "when": { "testing": true }
    },
    {
      "path": "files/api/routes/admin-write.vitest.ts",
      "target": "@api/routes/admin-write.test.ts",
      "when": { "testing": true }
    },
    {
      "path": "files/db/schema/audit.sqlite.ts",
      "target": "@db/schema/audit.ts",
      "onlyWith": "database-d1"
    },
    {
      "path": "files/db/schema/audit.pg.ts",
      "target": "@db/schema/audit.ts",
      "onlyWith": "database-postgres"
    },
    {
      "path": "files/db/repositories/audit.ts",
      "target": "@db/repositories/audit.ts"
    },
    {
      "path": "files/api/routes/admin-members.ts",
      "target": "@api/routes/admin-members.ts"
    },
    {
      "path": "files/api/routes/admin-audit.ts",
      "target": "@api/routes/admin-audit.ts"
    },
    {
      "path": "files/api/lib/members.ts",
      "target": "@api/lib/members.ts"
    },
    {
      "path": "files/api/lib/audit-query.ts",
      "target": "@api/lib/audit-query.ts"
    },
    {
      "path": "files/api/routes/admin-members.vitest.ts",
      "target": "@api/routes/admin-members.test.ts",
      "when": { "testing": true }
    },
    {
      "path": "files/api/routes/admin-audit.vitest.ts",
      "target": "@api/routes/admin-audit.test.ts",
      "when": { "testing": true }
    },
    {
      "path": "files/db/repositories/members.ts",
      "target": "@db/repositories/members.ts"
    },
    {
      "path": "files/db/seed/audit-events.ts",
      "target": "@db/seed/slices/audit-events.ts"
    },
    {
      "path": "files/ui/styles/admin.css",
      "target": "@ui/styles/admin.css"
    }
  ],
  "scaffolds": [
    {
      "workspace": "apps/admin",
      "aliases": {
        "@admin": "apps/admin/src"
      },
      "files": [
        {
          "path": "files/package.json",
          "target": "package.json"
        },
        {
          "path": "files/tsconfig.json",
          "target": "tsconfig.json"
        },
        {
          "path": "files/wrangler.jsonc",
          "target": "wrangler.jsonc"
        },
        {
          "path": "files/vite.config.ts",
          "target": "vite.config.ts"
        },
        {
          "path": "files/tsr.config.json",
          "target": "tsr.config.json"
        },
        {
          "path": "files/src/env.ts",
          "target": "src/env.ts"
        },
        {
          "path": "files/index.html",
          "target": "index.html"
        },
        {
          "path": "files/DESIGN.md",
          "target": "DESIGN.md"
        },
        {
          "path": "files/src/main.tsx",
          "target": "src/main.tsx"
        },
        {
          "path": "files/src/routeTree.gen.ts",
          "target": "src/routeTree.gen.ts"
        },
        {
          "path": "files/src/lib/auth.ts",
          "target": "src/lib/auth.ts"
        },
        {
          "path": "files/src/lib/api.ts",
          "target": "src/lib/api.ts"
        },
        {
          "path": "files/src/lib/redirect.ts",
          "target": "src/lib/redirect.ts"
        },
        {
          "path": "files/src/lib/initials.ts",
          "target": "src/lib/initials.ts"
        },
        {
          "path": "files/src/components/app-shell.tsx",
          "target": "src/components/app-shell.tsx"
        },
        {
          "path": "files/src/extend/root.tsx",
          "target": "src/extend/root.tsx",
          "seed": true
        },
        {
          "path": "files/src/components/nav.ts",
          "target": "src/components/nav.ts"
        },
        {
          "path": "files/src/components/commands.ts",
          "target": "src/components/commands.ts"
        },
        {
          "path": "files/src/components/shell-extensions.ts",
          "target": "src/components/shell-extensions.ts"
        },
        {
          "path": "files/src/components/nav-counts.ts",
          "target": "src/components/nav-counts.ts"
        },
        {
          "path": "files/src/components/access-denied.tsx",
          "target": "src/components/access-denied.tsx"
        },
        {
          "path": "files/src/components/sign-out-button.tsx",
          "target": "src/components/sign-out-button.tsx"
        },
        {
          "path": "files/src/routes/__root.tsx",
          "target": "src/routes/__root.tsx"
        },
        {
          "path": "files/src/routes/login.tsx",
          "target": "src/routes/login.tsx"
        },
        {
          "path": "files/src/routes/index.tsx",
          "target": "src/routes/index.tsx"
        },
        {
          "path": "files/src/routes/users.tsx",
          "target": "src/routes/users.tsx"
        },
        {
          "path": "files/src/components/route-error.tsx",
          "target": "src/components/route-error.tsx"
        },
        {
          "path": "files/src/lib/users-query.ts",
          "target": "src/lib/users-query.ts"
        },
        {
          "path": "files/src/routes/members.tsx",
          "target": "src/routes/members.tsx"
        },
        {
          "path": "files/src/routes/activity.tsx",
          "target": "src/routes/activity.tsx"
        },
        {
          "path": "files/src/lib/members-query.ts",
          "target": "src/lib/members-query.ts"
        },
        {
          "path": "files/src/lib/activity.ts",
          "target": "src/lib/activity.ts"
        },
        {
          "path": "files/src/lib/activity-query.ts",
          "target": "src/lib/activity-query.ts"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-admin"]
  }
}
