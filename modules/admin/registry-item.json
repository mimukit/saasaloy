{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "admin",
  "type": "saasaloy:capability",
  "requires": { "saasaloy": ">=0.6.0" },
  "dependsOn": ["api", "auth"],
  "dependencies": [],
  "envVars": {
    "PUBLIC_API_URL": "Origin the admin SPA calls for api and auth requests (e.g. https://api.x.com). Falls back to http://localhost:4000 in dev. The `PUBLIC_` prefix is what vite.config.ts exposes to the browser bundle."
  },
  "envServices": {
    "default": ["admin"]
  },
  "patches": [
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/admin",
      "call": "adminUsers",
      "import": {
        "name": "adminUsers",
        "from": "./routes/admin-users"
      }
    },
    {
      "file": "packages/env/src/services.ts",
      "kind": "const-array",
      "constName": "SERVICES",
      "key": "name",
      "entry": {
        "name": "admin",
        "file": "apps/admin/.env",
        "environment": "dev",
        "omit": []
      }
    },
    {
      "file": "packages/ui/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@tanstack/react-table",
      "range": "9.2.4"
    },
    {
      "file": "packages/tooling/src/targets.ts",
      "kind": "const-array",
      "constName": "DEPLOY_TARGETS",
      "key": "service",
      "entry": {
        "service": "admin",
        "order": 20
      }
    },
    {
      "file": "packages/tooling/src/targets.ts",
      "kind": "const-array",
      "constName": "SMOKE_CHECKS",
      "key": "id",
      "entry": {
        "id": "admin-home",
        "service": "admin",
        "path": "/",
        "status": 200
      }
    }
  ],
