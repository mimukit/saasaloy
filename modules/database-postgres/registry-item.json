{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "database-postgres",
  "type": "saasaloy:feature",
  "description": "The Postgres database driver over postgres.js, with a Hyperdrive-aware getDb and a withDb helper.",
  "stage": "validate",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["database"],
  "conflictsWith": ["database-d1"],
  "dependencies": [],
  "envVars": {
    "DATABASE_URL": "Postgres connection string, e.g. postgres://user:pass@host:5432/app. Read from apps/api/.env in local dev (saasaloy env, then pnpm env:setup) and from a Workers secret (`wrangler secret put DATABASE_URL`) in production. A HYPERDRIVE binding, when present, takes precedence over it. Unset with no HYPERDRIVE binding, `getDb` throws \"No Postgres connection\" on the first request and the route returns a 500. Add `?sslmode=verify-full` to the string for a remote database: postgres.js connects without TLS unless the string asks for it."
  },
  "envServices": {
    "default": ["api"]
  },
  "patches": [
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "compatibility_flags",
      "entry": "nodejs_compat"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:migrate",
      "value": "drizzle-kit migrate"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:setup",
      "value": "node scripts/setup.ts"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:status",
      "value": "node scripts/status.ts"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:drop",
      "value": "node scripts/drop.ts"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:seed",
      "value": "node scripts/seed.ts"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:prod:dump",
      "value": "env-deploy --run api -- node scripts/prod.ts dump"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:prod:migrate",
      "value": "env-deploy --run api -- node scripts/prod.ts migrate"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:prod:readonly-grants",
      "value": "env-deploy --run api -- node scripts/readonly-grants.ts"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:prod:query",
      "value": "node scripts/query.ts"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:prod:superadmin",
      "value": "env-deploy --run api -- node scripts/superadmin.ts",
      "when": { "installed": ["auth"] }
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:setup",
      "value": "pnpm --filter @repo/db db:setup"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:status",
      "value": "pnpm --filter @repo/db db:status"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:drop",
      "value": "pnpm --filter @repo/db db:drop"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:seed",
      "value": "pnpm --filter @repo/db db:seed"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:prod:dump",
      "value": "pnpm --filter @repo/db db:prod:dump"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:prod:migrate",
      "value": "pnpm --filter @repo/db db:prod:migrate"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:prod:readonly-grants",
      "value": "pnpm --filter @repo/db db:prod:readonly-grants"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:prod:query",
      "value": "pnpm --filter @repo/db db:prod:query"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:prod:superadmin",
      "value": "pnpm --filter @repo/db db:prod:superadmin",
      "when": { "installed": ["auth"] }
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "postgres",
      "range": "3.4.9"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/env",
      "range": "workspace:*"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-dependency",
      "section": "devDependencies",
      "name": "@types/node",
      "range": "26.6.3"
    },
    {
      "file": "apps/api/src/env.ts",
      "kind": "plugin-array",
      "exportName": "apiEnv",
      "arrayProp": "extends",
      "call": "databaseEnv",
      "import": {
        "name": "databaseEnv",
        "from": "@repo/db/env-preset"
      }
    }
  ],
  "files": [
    {
      "path": "files/src/client.ts",
      "target": "@db/client.ts"
    },
    {
      "path": "files/src/env-preset.ts",
      "target": "@db/env-preset.ts"
    },
    {
      "path": "files/compose.yaml",
      "target": "@root/compose.yaml"
    },
    {
      "path": "files/src/testing.ts",
      "target": "@db/testing.ts"
    }
  ],
  "scaffolds": [
    {
      "workspace": "packages/db",
      "aliases": { "@root": "." },
      "files": [
        {
          "path": "files/drizzle.config.ts",
