{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "database-postgres",
  "type": "saasaloy:feature",
  "dependsOn": ["database"],
  "conflictsWith": ["database-d1"],
  "dependencies": [],
  "envVars": {
    "DATABASE_URL": "Postgres connection string, e.g. postgres://user:pass@host:5432/app. Read from apps/api/.env in local dev (saasaloy env, then pnpm env:setup) and from a Workers secret (`wrangler secret put DATABASE_URL`) in production. A HYPERDRIVE binding, when present, takes precedence over it. Unset with no HYPERDRIVE binding, `getDb` throws \"No Postgres connection\" on the first request and the route returns a 500. Add `?sslmode=verify-full` to the string for a remote database: postgres.js connects without TLS unless the string asks for it."
  },
  "envServices": {
    "default": ["api"]
  },
  "patches": [
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "compatibility_flags",
      "entry": "nodejs_compat"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:migrate",
      "value": "drizzle-kit migrate"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "postgres",
      "range": "3.4.9"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-dependency",
      "section": "devDependencies",
      "name": "@types/node",
      "range": "26.4.1"
    },
    {
      "file": "apps/api/src/env.ts",
      "kind": "plugin-array",
      "exportName": "apiEnv",
      "arrayProp": "extends",
      "call": "databaseEnv",
      "import": {
        "name": "databaseEnv",
        "from": "@repo/db/env-preset"
      }
    }
  ],
  "files": [
    {
      "path": "files/src/client.ts",
      "target": "@db/client.ts"
    },
    {
      "path": "files/src/env-preset.ts",
      "target": "@db/env-preset.ts"
    }
  ],
  "scaffolds": [
    {
      "workspace": "packages/db",
      "files": [
        {
          "path": "files/drizzle.config.ts",
          "target": "drizzle.config.ts"
        },
        {
          "path": "files/tsconfig.json",
          "target": "tsconfig.json"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-database-postgres"]
  }
}
