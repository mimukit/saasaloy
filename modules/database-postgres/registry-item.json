        },
        {
          "path": "files/scripts/prod.ts",
          "target": "scripts/prod.ts"
        },
        {
          "path": "files/scripts/lib/readonly.ts",
          "target": "scripts/lib/readonly.ts"
        },
        {
          "path": "files/scripts/lib/readonly-grants.ts",
          "target": "scripts/lib/readonly-grants.ts"
        },
        {
          "path": "files/scripts/lib/query.ts",
          "target": "scripts/lib/query.ts"
        },
        {
          "path": "files/scripts/lib/mask.ts",
          "target": "scripts/lib/mask.ts"
        },
        {
          "path": "files/scripts/readonly-grants.ts",
          "target": "scripts/readonly-grants.ts"
        },
        {
          "path": "files/scripts/query.ts",
          "target": "scripts/query.ts"
        },
        {
