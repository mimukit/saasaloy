{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "database-postgres",
  "type": "saasaloy:feature",
  "dependsOn": ["database"],
  "conflictsWith": ["database-d1"],
  "dependencies": [],
  "envVars": {
    "DATABASE_URL": "Postgres connection string, e.g. postgres://user:pass@host:5432/app. Read from apps/api/.dev.vars in local dev and from a Workers secret (`wrangler secret put DATABASE_URL`) in production. A HYPERDRIVE binding, when present, takes precedence over it. Unset with no HYPERDRIVE binding, `getDb` throws \"No Postgres connection\" on the first request and the route returns a 500. Add `?sslmode=verify-full` to the string for a remote database: postgres.js connects without TLS unless the string asks for it."
  },
  "patches": [
    {
      "file": "apps/api/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "compatibility_flags",
      "entry": "nodejs_compat"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:migrate",
      "value": "drizzle-kit migrate"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:setup",
      "value": "node scripts/setup.ts"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:status",
      "value": "node scripts/status.ts"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-script",
      "name": "db:drop",
      "value": "node scripts/drop.ts"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:setup",
      "value": "pnpm --filter @repo/db db:setup"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:status",
      "value": "pnpm --filter @repo/db db:status"
    },
    {
      "file": "package.json",
      "kind": "package-json-script",
      "name": "db:drop",
      "value": "pnpm --filter @repo/db db:drop"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "postgres",
      "range": "3.4.9"
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-dependency",
      "section": "devDependencies",
      "name": "@types/node",
      "range": "26.4.1"
    }
  ],
  "files": [
    {
      "path": "files/src/client.ts",
      "target": "@db/client.ts"
    },
    {
      "path": "files/compose.yaml",
      "target": "@root/compose.yaml"
    }
  ],
  "scaffolds": [
    {
      "workspace": "packages/db",
      "aliases": { "@root": "." },
      "files": [
        {
          "path": "files/drizzle.config.ts",
          "target": "drizzle.config.ts"
        },
        {
          "path": "files/tsconfig.json",
          "target": "tsconfig.json"
        },
        {
          "path": "files/scripts/setup.ts",
          "target": "scripts/setup.ts"
        },
        {
          "path": "files/scripts/status.ts",
          "target": "scripts/status.ts"
        },
        {
          "path": "files/scripts/drop.ts",
          "target": "scripts/drop.ts"
        },
        {
          "path": "files/scripts/lib/branch-name.ts",
          "target": "scripts/lib/branch-name.ts"
        },
        {
          "path": "files/scripts/lib/context.ts",
          "target": "scripts/lib/context.ts"
        },
        {
          "path": "files/scripts/lib/env-file.ts",
          "target": "scripts/lib/env-file.ts"
        },
        {
          "path": "files/scripts/lib/state.ts",
          "target": "scripts/lib/state.ts"
        },
        {
          "path": "files/scripts/lib/url.ts",
          "target": "scripts/lib/url.ts"
        },
        {
          "path": "files/scripts/backends/docker.ts",
          "target": "scripts/backends/docker.ts"
        },
        {
          "path": "files/scripts/backends/neon.ts",
          "target": "scripts/backends/neon.ts"
        },
        {
          "path": "files/scripts/backends/server.ts",
          "target": "scripts/backends/server.ts"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-database-postgres"]
  }
}
