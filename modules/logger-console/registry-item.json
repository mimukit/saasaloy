{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "logger-console",
  "type": "saasaloy:feature",
  "description": "A logger provider that writes structured JSON to the Worker's console.",
  "stage": "validate",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["logger"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "packages/logger/src/index.ts",
      "kind": "plugin-array",
      "exportName": "logger",
      "arrayProp": "providers",
      "call": "consoleLogger",
      "import": {
        "name": "consoleLogger",
        "from": "./providers/console"
      }
    }
  ],
  "files": [
    { "path": "files/console.ts", "target": "@logger/providers/console.ts" }
  ],
  "scaffolds": []
}
