{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "api-keys",
  "type": "saasaloy:feature",
  "description": "API keys on the Better Auth api-key plugin, stored as a hash; pick api-keys-organization or api-keys-user as the owner.",
  "stage": "scale",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["auth"],
  "requiresOneOf": ["api-keys-organization", "api-keys-user"],
  "dependencies": [],
  "envVars": {},
  "removeWarnings": [
    "The @better-auth/api-key dependency stays in packages/auth/package.json. A package-json-dependency patch has no removal inverse, so drop the line by hand and run pnpm install."
  ],
  "patches": [
    {
      "file": "packages/auth/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@better-auth/api-key",
      "range": "1.7.7"
    },
    {
      "file": "packages/auth/src/auth.ts",
      "kind": "plugin-array",
      "exportName": "auth",
      "arrayProp": "plugins",
      "call": "apiKeyPlugin",
      "import": {
        "name": "apiKeyPlugin",
        "from": "./plugins/api-key"
      }
    },
    {
      "file": "packages/auth/src/auth.ts",
      "kind": "plugin-array",
      "exportName": "adminAuth",
      "arrayProp": "plugins",
      "call": "apiKeyPlugin",
      "import": {
        "name": "apiKeyPlugin",
        "from": "./plugins/api-key"
      }
    },
    {
      "file": "packages/auth/src/auth.ts",
      "kind": "plugin-array",
      "exportName": "auth",
      "arrayProp": "plugins",
      "call": "apiKeyScopeGuard",
      "import": {
        "name": "apiKeyScopeGuard",
        "from": "./plugins/api-key"
      }
    },
    {
      "file": "packages/auth/src/auth.ts",
      "kind": "plugin-array",
      "exportName": "adminAuth",
      "arrayProp": "plugins",
      "call": "apiKeyScopeGuard",
      "import": {
        "name": "apiKeyScopeGuard",
        "from": "./plugins/api-key"
      }
    },
    {
      "file": "packages/auth/src/client.ts",
      "kind": "plugin-array",
      "exportName": "authClientPlugins",
      "arrayProp": "plugins",
      "call": "apiKeyClientPlugin",
      "import": {
        "name": "apiKeyClientPlugin",
        "from": "./plugins/api-key-client"
      }
    },
    {
      "file": "packages/auth/src/client.ts",
      "kind": "plugin-array",
      "exportName": "adminAuthClientPlugins",
      "arrayProp": "plugins",
      "call": "apiKeyClientPlugin",
      "import": {
        "name": "apiKeyClientPlugin",
        "from": "./plugins/api-key-client"
      }
    }
  ],
  "files": [
    {
      "path": "files/auth/plugins/api-key-options.ts",
      "target": "@auth/plugins/api-key-options.ts"
    },
    {
      "path": "files/auth/plugins/api-key-options.vitest.ts",
      "target": "@auth/plugins/api-key-options.test.ts",
      "when": { "testing": true }
    },
    {
      "path": "files/auth/plugins/api-key-client.ts",
      "target": "@auth/plugins/api-key-client.ts"
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-api-keys"]
  }
}
