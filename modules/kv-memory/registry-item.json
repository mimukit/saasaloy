{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "kv-memory",
  "type": "saasaloy:feature",
  "description": "A kv provider that keeps entries in memory, for local development and tests.",
  "stage": "scale",
  "needs": [],
  "requires": { "saasaloy": ">=0.10.0" },
  "dependsOn": ["kv"],
  "dependencies": [],
  "envVars": {},
  "files": [
    {
      "path": "files/memory.ts",
      "target": "@kv/providers/memory.ts"
    }
  ],
  "entries": [
    {
      "table": "kv.providers",
      "call": "memory",
      "import": {
        "name": "memory",
        "from": "./providers/memory"
      }
    }
  ],
  "scaffolds": []
}
