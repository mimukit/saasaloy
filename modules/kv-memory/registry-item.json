{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "kv-memory",
  "type": "saasaloy:feature",
  "description": "A kv provider that keeps entries in memory, for local development and tests.",
  "stage": "scale",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["kv"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "packages/kv/src/index.ts",
      "kind": "plugin-array",
      "exportName": "kv",
      "arrayProp": "providers",
      "call": "memory",
      "import": {
        "name": "memory",
        "from": "./providers/memory"
      }
    }
  ],
  "files": [
    { "path": "files/memory.ts", "target": "@kv/providers/memory.ts" },
    {
      "path": "files/memory.vitest.ts",
      "target": "@kv/providers/memory.test.ts",
      "when": { "testing": true }
    }
  ],
  "scaffolds": []
}
