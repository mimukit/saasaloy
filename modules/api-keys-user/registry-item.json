{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "api-keys-user",
  "type": "saasaloy:feature",
  "description": "User-owned API keys with their own scopes and rules, for a project with no organizations.",
  "stage": "scale",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["api-keys", "auth"],
  "conflictsWith": ["api-keys-organization"],
  "dependencies": [],
  "envVars": {},
  "removeWarnings": [
    "The deployed api_keys table survives this removal. Run db:generate and review the resulting drop migration before you apply it. Every key in it stops working the moment requireCaller goes, so tell the machine callers before you remove this module, not after. Every route that imports @repo/auth/caller stops compiling."
  ],
  "patches": [
    {
      "file": "packages/auth/src/auth.ts",
      "kind": "plugin-array",
      "exportName": "adminAuth",
      "arrayProp": "plugins",
      "call": "apiKeyAdminGuard",
      "import": {
        "name": "apiKeyAdminGuard",
        "from": "./plugins/api-key"
      }
    }
  ],
  "files": [
    {
      "path": "files/db/schema/api-keys.sqlite.ts",
      "target": "@db/schema/api-keys.ts",
      "onlyWith": "database-d1"
    },
    {
      "path": "files/db/schema/api-keys.pg.ts",
      "target": "@db/schema/api-keys.ts",
      "onlyWith": "database-postgres"
    },
    {
      "path": "files/auth/plugins/api-key.ts",
      "target": "@auth/plugins/api-key.ts"
    },
    {
      "path": "files/auth/api-key-scopes.ts",
      "target": "@auth/api-key-scopes.ts"
    },
    {
      "path": "files/auth/api-key-rules.ts",
      "target": "@auth/api-key-rules.ts"
    },
    {
      "path": "files/auth/caller.ts",
      "target": "@auth/caller.ts"
    },
    {
      "path": "files/db/seed/api-keys.ts",
      "target": "@db/seed/slices/api-keys.ts"
    }
  ]
}
