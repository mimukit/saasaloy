{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "billing",
  "type": "saasaloy:capability",
  "description": "Subscriptions in a packages/billing workspace: the provider contract, plans.ts, the subscription projection and the plan entitlements.",
  "stage": "money",
  "needs": [],
  "requires": { "saasaloy": ">=0.8.0" },
  "dependsOn": ["api", "database", "auth", "admin", "queue", "email"],
  "dependencies": [],
  "envVars": {
    "BILLING_PROVIDER": "Which installed provider takes payments: `stripe` (add billing-stripe) or `console` (add billing-console). Always required — there is no default, so nothing charges a real card by accident and nothing stops taking payments silently.",
    "BILLING_LOCKOUT_DAYS": "How many days a subscription may stay past_due before the daily lockout job sets locked_at and the subject drops to the default plan. Optional; 14 when unset.",
    "BILLING_APP_URL": "Absolute https URL the billing emails link to, normally your admin app's /billing page. Also the one origin the checkout, portal and change-plan routes accept a redirect URL on. Optional; http://localhost:3001/billing when unset, which is the dev default and is refused by the email renderer on any host but localhost."
  },
  "envServices": {
    "default": ["api"]
  },
  "envOptional": ["BILLING_LOCKOUT_DAYS", "BILLING_APP_URL"],
  "removeWarnings": [
    "The deployed billing_subscriptions and billing_events tables survive this removal, and so does the users.billing_customer_id column the schema file loses. Run db:generate and review the resulting drop migration before you apply it.",
    "Removing this module does not cancel anything at the payment provider. Cancel live subscriptions in the vendor's own dashboard first.",
    "Any route still wrapped in requireFeature() or requireWithinLimit() loses its import when this module goes. Search apps/api for both names before you remove it."
  ],
  "patches": [
    {
      "file": "apps/api/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/billing",
      "range": "workspace:*"
    },
    {
      "file": "packages/auth/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/billing",
      "range": "workspace:*"
    },
    {
      "file": "packages/config/src/sections.ts",
      "kind": "plugin-array",
      "exportName": "sections",
      "arrayProp": "sections",
      "call": "billingConfigSection",
      "import": {
        "name": "billingConfigSection",
        "from": "./sections/billing"
      }
    },
    {
      "file": "apps/api/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "drizzle-orm",
      "range": "0.45.3"
    },
    {
      "file": "packages/queue/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/billing",
      "range": "workspace:*"
    },
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/billing",
      "call": "billingRoute",
      "import": {
        "name": "billingRoute",
        "from": "./routes/billing"
      }
    },
    {
      "file": "packages/queue/src/index.ts",
      "kind": "plugin-array",
      "exportName": "queue",
      "arrayProp": "jobs",
      "call": "billingEventJob",
      "import": {
        "name": "billingEventJob",
        "from": "@repo/billing"
      }
    },
    {
      "file": "packages/queue/src/index.ts",
      "kind": "plugin-array",
      "exportName": "queue",
      "arrayProp": "jobs",
      "call": "pastDueLockoutJob",
      "import": {
        "name": "pastDueLockoutJob",
        "from": "@repo/billing"
      }
    },
    {
      "file": "packages/queue/src/index.ts",
      "kind": "plugin-array",
      "exportName": "queue",
      "arrayProp": "schedules",
      "call": "pastDueLockoutSchedule",
      "import": {
        "name": "pastDueLockoutSchedule",
        "from": "@repo/billing"
      }
    },
    {
      "file": "apps/admin/src/components/nav.ts",
      "kind": "nav-entry",
      "constName": "NAV_AREAS",
      "area": "/",
      "group": "Manage",
      "entry": { "to": "/billing", "label": "Billing" },
      "icon": { "name": "CreditCardIcon", "from": "lucide-react" }
    },
    {
      "file": "packages/db/src/schema/auth.ts",
      "kind": "drizzle-column",
      "exportName": "users",
      "column": "billingCustomerId",
      "value": "text(\"billing_customer_id\")"
    },
    {
      "file": "apps/api/src/env.ts",
      "kind": "plugin-array",
      "exportName": "apiEnv",
      "arrayProp": "extends",
      "call": "billingEnv",
      "import": {
        "name": "billingEnv",
        "from": "@repo/billing/env-preset"
      }
    }
  ],
  "files": [
    {
      "path": "files/api/routes/billing.ts",
      "target": "@api/routes/billing.ts"
    },
    {
      "path": "files/api/routes/billing.vitest.ts",
      "target": "@api/routes/billing.test.ts",
      "when": {
        "testing": true,
        "installed": ["billing-console", "queue-memory"]
      }
    },
    {
      "path": "files/api/billing-store.ts",
      "target": "@api/billing-store.ts"
    },
    {
      "path": "files/api/billing-entitlements.vitest.ts",
      "target": "@api/billing-entitlements.test.ts",
      "when": {
        "testing": true,
        "installed": ["billing-console", "queue-memory"]
      }
    },
    {
      "path": "files/config/billing.ts",
      "target": "@config/sections/billing.ts"
    },
    {
      "path": "files/api/require-feature.ts",
      "target": "@api/middleware/require-feature.ts"
    },
    {
      "path": "files/admin/routes/billing.tsx",
      "target": "@admin/routes/billing.tsx"
    },
    {
      "path": "files/email/templates/trial-ending.ts",
      "target": "@email/templates/trial-ending.ts"
    },
    {
      "path": "files/email/templates/payment-failed.ts",
      "target": "@email/templates/payment-failed.ts"
    },
    {
      "path": "files/email/templates/account-locked.ts",
      "target": "@email/templates/account-locked.ts"
    },
    {
      "path": "files/email/templates.vitest.ts",
      "target": "@email/templates.test.ts",
      "when": { "testing": true }
    },
    {
      "path": "files/db/schema/billing.sqlite.ts",
      "target": "@db/schema/billing.ts",
      "onlyWith": "database-d1"
    },
    {
      "path": "files/db/schema/billing.pg.ts",
      "target": "@db/schema/billing.ts",
      "onlyWith": "database-postgres"
    },
    {
      "path": "files/db/seed/billing-subscriptions.ts",
      "target": "@db/seed/slices/billing-subscriptions.ts"
    },
    {
      "path": "files/db/seed/billing-events.ts",
      "target": "@db/seed/slices/billing-events.ts"
    }
  ],
  "scaffolds": [
    {
      "workspace": "packages/billing",
      "aliases": {
        "@billing": "packages/billing/src"
      },
      "files": [
        {
          "path": "files/package.json",
          "target": "package.json"
        },
        {
          "path": "files/tsconfig.json",
          "target": "tsconfig.json"
        },
        {
          "path": "files/src/index.ts",
          "target": "src/index.ts"
        },
        {
          "path": "files/src/define.ts",
          "target": "src/define.ts"
        },
        {
          "path": "files/src/define.vitest.ts",
          "target": "src/define.test.ts",
          "when": { "testing": true }
        },
        {
          "path": "files/src/provider.ts",
          "target": "src/provider.ts"
        },
        {
          "path": "files/src/plans.ts",
          "target": "src/plans.ts",
          "untested": "The owner's plan table; data, not logic."
        },
        {
          "path": "files/src/entitlements.ts",
          "target": "src/entitlements.ts",
          "untested": "Tested by apps/api's billing-entitlements.test.ts, which drives it over queue-memory; packages/billing cannot depend on @repo/queue, which depends on it."
        },
        {
          "path": "files/src/subject.ts",
          "target": "src/subject.ts",
          "untested": "No test yet: resolves the billable subject from a session."
        },
        {
          "path": "files/src/subscription.ts",
          "target": "src/subscription.ts"
        },
        {
          "path": "files/src/subscription.vitest.ts",
          "target": "src/subscription.test.ts",
          "when": { "testing": true }
        },
        {
          "path": "files/src/store.ts",
          "target": "src/store.ts",
          "untested": "The store resolver the tests set through setBillingStoreResolver; no rule of its own."
        },
        {
          "path": "files/src/enqueue.ts",
          "target": "src/enqueue.ts",
          "untested": "A setter and a getter for the enqueuer; no rule of its own."
        },
        {
          "path": "files/src/notify.ts",
          "target": "src/notify.ts",
          "untested": "A setter and a getter for the notifier; subscription.test.ts drives it."
        },
        {
          "path": "files/src/config.ts",
          "target": "src/config.ts"
        },
        {
          "path": "files/src/config.vitest.ts",
          "target": "src/config.test.ts",
          "when": { "testing": true }
        },
        {
          "path": "files/src/jobs/event.ts",
          "target": "src/jobs/event.ts"
        },
        {
          "path": "files/src/jobs/event.vitest.ts",
          "target": "src/jobs/event.test.ts",
          "when": { "testing": true }
        },
        {
          "path": "files/src/jobs/past-due-lockout.ts",
          "target": "src/jobs/past-due-lockout.ts"
        },
        {
          "path": "files/src/jobs/past-due-lockout.vitest.ts",
          "target": "src/jobs/past-due-lockout.test.ts",
          "when": { "testing": true }
        },
        {
          "path": "files/src/jobs/event-handler.ts",
          "target": "src/jobs/event-handler.ts",
          "untested": "The queue job around applyEvent; jobs/event.test.ts covers the event path."
        },
        {
          "path": "files/src/providers/.gitkeep",
          "target": "src/providers/.gitkeep"
        },
        {
          "path": "files/src/env-preset.ts",
          "target": "src/env-preset.ts"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-billing"]
  }
}
