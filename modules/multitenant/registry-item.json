{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "multitenant",
  "type": "saasaloy:feature",
  "requires": { "saasaloy": ">=0.5.1" },
  "dependsOn": ["api", "database", "auth", "teams", "admin"],
  "dependencies": [],
  "envVars": {},
  "removeWarnings": [
    "The deployed projects table survives this removal. Run db:generate and review the resulting drop migration before you apply it.",
    "Every route written against requireTenant, forTenant or requirePermission stops compiling once packages/auth/src/tenant.ts, packages/auth/src/permissions.ts and packages/db/src/tenant.ts are gone. Rewrite or delete those routes before you remove this module.",
    "Custom roles stored in the organization_roles table stay live after this removal: teams keeps dynamicAccessControl, so members holding a custom role keep its statements, but the /roles screen that edits and deletes those roles goes with this module. Edit, reassign or delete custom roles before you remove this module, or manage them afterwards through the Better Auth organization API."
  ],
  "patches": [
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/tenant",
      "call": "tenantRoute",
      "import": { "name": "tenantRoute", "from": "./routes/tenant" }
    },
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/projects",
      "call": "projects",
      "import": { "name": "projects", "from": "./routes/projects" }
    },
    {
      "file": "apps/admin/src/components/nav.ts",
      "kind": "nav-entry",
      "constName": "NAV_AREAS",
      "area": "/",
      "group": "Manage",
      "entry": { "to": "/roles", "label": "Roles" },
      "icon": { "name": "ShieldCheckIcon", "from": "lucide-react" }
    }
  ],
  "files": [
    { "path": "files/db/tenant.ts", "target": "@db/tenant.ts" },
    {
      "path": "files/db/tenant-column.sqlite.ts",
      "target": "@db/tenant-column.ts",
      "onlyWith": "database-d1"
    },
    {
      "path": "files/db/tenant-column.pg.ts",
      "target": "@db/tenant-column.ts",
      "onlyWith": "database-postgres"
    },
    {
      "path": "files/db/tenant.typecheck.ts",
      "target": "@db/tenant.typecheck.ts"
    },
    {
      "path": "files/db/schema/projects.sqlite.ts",
      "target": "@db/schema/projects.ts",
      "onlyWith": "database-d1"
    },
    {
      "path": "files/db/schema/projects.pg.ts",
      "target": "@db/schema/projects.ts",
      "onlyWith": "database-postgres"
    },
    {
      "path": "files/db/repositories/organization-roles.ts",
      "target": "@db/repositories/organization-roles.ts"
    },
    {
      "path": "files/db/repositories/organizations.ts",
      "target": "@db/repositories/organizations.ts"
    },
    {
      "path": "files/db/repositories/projects.ts",
      "target": "@db/repositories/projects.ts"
    },
    { "path": "files/auth/tenant-rules.ts", "target": "@auth/tenant-rules.ts" },
    { "path": "files/auth/tenant.ts", "target": "@auth/tenant.ts" },
    { "path": "files/auth/statements.ts", "target": "@auth/statements.ts" },
    { "path": "files/api/routes/tenant.ts", "target": "@api/routes/tenant.ts" },
    {
      "path": "files/api/routes/projects.ts",
      "target": "@api/routes/projects.ts"
    },
    {
      "path": "files/db/seed/projects.ts",
      "target": "@db/seed/slices/projects.ts"
    },
    { "path": "files/auth/permissions.ts", "target": "@auth/permissions.ts" },
    { "path": "files/admin/lib/tenant.ts", "target": "@admin/lib/tenant.ts" },
    {
      "path": "files/admin/routes/roles.tsx",
      "target": "@admin/routes/roles.tsx"
    },
    {
      "path": "files/admin/components/role-workspace.tsx",
      "target": "@admin/components/role-workspace.tsx"
    },
    {
      "path": "files/admin/components/permission-grid.tsx",
      "target": "@admin/components/permission-grid.tsx"
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-multitenant"]
  }
}
