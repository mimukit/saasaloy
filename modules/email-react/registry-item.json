{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "email-react",
  "type": "saasaloy:feature",
  "description": "Opt-in JSX email templates on React Email in a packages/email-react workspace, with a preview server.",
  "stage": "mvp",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["email"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "packages/env/src/services.ts",
      "kind": "const-array",
      "constName": "SERVICES",
      "key": "name",
      "entry": {
        "name": "email-react",
        "file": "packages/email-react/.env",
        "environment": "dev",
        "omit": [],
        "devPort": 3003
      }
    },
    {
      "file": "apps/api/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/email-react",
      "range": "workspace:*"
    }
  ],
  "files": [],
  "scaffolds": [
    {
      "workspace": "packages/email-react",
      "aliases": { "@email-react": "packages/email-react/src" },
      "files": [
        { "path": "files/package.json", "target": "package.json" },
        { "path": "files/tsconfig.json", "target": "tsconfig.json" },
        { "path": "files/scripts/dev.ts", "target": "scripts/dev.ts" },
        { "path": "files/src/index.ts", "target": "src/index.ts" },
        { "path": "files/src/define.tsx", "target": "src/define.tsx" },
        {
          "path": "files/src/templates/welcome.tsx",
          "target": "src/templates/welcome.tsx"
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-email-react"]
  }
}
