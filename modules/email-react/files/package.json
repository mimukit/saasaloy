  },
  "devDependencies": {
    "@react-email/ui": "6.9.3",
    "@repo/tsconfig": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "react-email": "6.9.3",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  }
