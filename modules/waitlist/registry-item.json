{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "waitlist",
  "type": "saasaloy:feature",
  "dependsOn": ["api", "database", "validators"],
  "dependencies": [],
  "envVars": {
    "PUBLIC_API_URL": "Base URL of the api Worker the form posts to (defaults to http://localhost:4000 in dev)."
  },
  "patches": [
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/waitlist",
      "call": "waitlist",
      "import": {
        "name": "waitlist",
        "from": "./routes/waitlist"
      }
    },
    {
      "file": "apps/web/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "hono",
      "range": "4.13.5"
    },
    {
      "file": "apps/web/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/api",
      "range": "workspace:*"
    }
  ],
  "files": [
    {
      "path": "files/api/routes/waitlist.ts",
      "target": "@api/routes/waitlist.ts"
    },
    {
      "path": "files/db/schema/waitlist.sqlite.ts",
      "target": "@db/schema/waitlist.ts",
      "onlyWith": "database-d1"
    },
    {
      "path": "files/db/schema/waitlist.pg.ts",
      "target": "@db/schema/waitlist.ts",
      "onlyWith": "database-postgres"
    },
    {
      "path": "files/validators/waitlist.ts",
      "target": "@validators/waitlist.ts"
    },
    {
      "path": "files/ui/blocks/waitlist.tsx",
      "target": "@ui/blocks/waitlist.tsx"
    },
    {
      "path": "files/web/components/WaitlistForm.tsx",
      "target": "@web/components/WaitlistForm.tsx"
    },
    {
      "path": "files/web/types/waitlist-env.d.ts",
      "target": "@web/types/waitlist-env.d.ts"
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-waitlist"]
  }
}
