{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "api-keys-organization",
  "type": "saasaloy:feature",
  "description": "Organization-owned API keys scoped through can(), on multitenant, plus an API keys admin screen.",
  "stage": "scale",
  "needs": [],
  "requires": { "saasaloy": ">=0.7.0" },
  "dependsOn": ["api-keys", "multitenant"],
  "conflictsWith": ["api-keys-user"],
  "dependencies": [],
  "envVars": {},
  "removeWarnings": [
    "The deployed api_keys table survives this removal. Run db:generate and review the resulting drop migration before you apply it. Every key in it stops working the moment the bearer resolver goes, so tell the machine callers before you remove this module, not after."
  ],
  "patches": [
    {
      "file": "packages/auth/src/tenant.ts",
      "kind": "plugin-array",
      "exportName": "tenantResolvers",
      "arrayProp": "resolvers",
      "call": "apiKeyTenant",
      "import": {
        "name": "apiKeyTenant",
        "from": "./resolvers/api-key"
      }
    },
    {
      "file": "apps/admin/src/components/nav.ts",
      "kind": "nav-entry",
      "constName": "NAV_AREAS",
      "area": "/",
      "group": "Manage",
      "entry": { "to": "/api-keys", "label": "API keys" },
      "icon": { "name": "KeyRoundIcon", "from": "lucide-react" }
    }
  ],
  "files": [
    {
      "path": "files/db/schema/api-keys.sqlite.ts",
      "target": "@db/schema/api-keys.ts",
      "onlyWith": "database-d1"
    },
    {
      "path": "files/db/schema/api-keys.pg.ts",
      "target": "@db/schema/api-keys.ts",
      "onlyWith": "database-postgres"
    },
    {
      "path": "files/auth/plugins/api-key.ts",
      "target": "@auth/plugins/api-key.ts"
    },
    {
      "path": "files/auth/resolvers/api-key.ts",
      "target": "@auth/resolvers/api-key.ts"
    },
    {
      "path": "files/admin/routes/api-keys.tsx",
      "target": "@admin/routes/api-keys.tsx"
    },
    {
      "path": "files/admin/components/api-key-workspace.tsx",
      "target": "@admin/components/api-key-workspace.tsx"
    },
    {
      "path": "files/db/seed/api-keys.ts",
      "target": "@db/seed/slices/api-keys.ts"
    }
  ]
}
