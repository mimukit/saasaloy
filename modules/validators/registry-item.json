{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "validators",
  "type": "saasaloy:capability",
  "description": "A packages/validators workspace with the zod request schemas and the shared error envelope.",
  "stage": "validate",
  "needs": [],
  "requires": { "saasaloy": ">=0.8.0" },
  "dependsOn": ["api"],
  "dependencies": [],
  "envVars": {},
  "patches": [
    {
      "file": "apps/api/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/validators",
      "range": "workspace:*"
    }
  ],
  "files": [],
  "scaffolds": [
    {
      "workspace": "packages/validators",
      "aliases": { "@validators": "packages/validators/src" },
      "files": [
        { "path": "files/package.json", "target": "package.json" },
        { "path": "files/tsconfig.json", "target": "tsconfig.json" },
        {
          "path": "files/src/common.ts",
          "target": "src/common.ts",
          "untested": "Shared zod schemas; no rule of its own."
        },
        { "path": "files/src/phone.ts", "target": "src/phone.ts" },
        {
          "path": "files/src/phone.vitest.ts",
          "target": "src/phone.test.ts",
          "when": { "testing": true }
        }
      ]
    }
  ],
  "agent": {
    "skills": ["skills/saasaloy-validators"]
  }
}
