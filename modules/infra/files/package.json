{
  "name": "@repo/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "env-exec .env -- pulumi preview",
    "deploy": "env-exec .env -- pulumi up",
    "destroy": "env-exec .env -- pulumi destroy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pulumi/cloudflare": "6.20.0",
    "@pulumi/pulumi": "3.261.0",
    "jsonc-parser": "3.3.1",
    "@repo/env": "workspace:*"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "wrangler": "4.129.0"
  }
}
