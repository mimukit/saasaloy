{
  "name": "@repo/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "stack:init": "env-exec .env -- pulumi stack init prod",
    "preview": "env-exec .env -- pulumi preview",
    "deploy": "env-exec .env -- pulumi up",
    "destroy": "env-exec .env -- pulumi destroy",
    "clean": "rimraf -g .stage \"*.tsbuildinfo\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pulumi/cloudflare": "6.21.0",
    "@pulumi/pulumi": "3.266.0",
    "ignore": "7.0.11",
    "jsonc-parser": "3.3.1",
    "@repo/env": "workspace:*"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "26.6.3",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "wrangler": "4.145.0"
  }
}
