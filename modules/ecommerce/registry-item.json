{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "ecommerce",
  "type": "saasaloy:feature",
  "description": "An in-house shop on Postgres: products with variants, stock holds, carts, orders with a status machine, and flat-rate shipping zones.",
  "stage": "money",
  "needs": [],
  "requires": {
    "saasaloy": ">=0.9.0"
  },
  "dependsOn": [
    "api",
    "database-postgres",
    "validators",
    "auth",
    "auth-phone",
    "admin",
    "file-uploads",
    "payment",
    "cms"
  ],
  "dependencies": [],
  "patches": [
    {
      "file": "packages/config/src/sections.ts",
      "kind": "plugin-array",
      "exportName": "sections",
      "arrayProp": "sections",
      "call": "ecommerceConfig",
      "import": {
        "name": "ecommerceConfig",
        "from": "./sections/ecommerce"
      }
    },
    {
      "file": "packages/db/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/ecommerce",
      "range": "workspace:*"
    },
    {
      "file": "apps/api/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/ecommerce",
      "range": "workspace:*"
    },
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/shop",
      "call": "ecommerce",
      "import": {
        "name": "ecommerce",
        "from": "./routes/ecommerce"
      }
    },
    {
      "file": "apps/api/src/index.ts",
      "kind": "chained-route",
      "exportName": "default",
      "path": "/admin/shop",
      "call": "adminEcommerce",
      "import": {
        "name": "adminEcommerce",
        "from": "./routes/admin-ecommerce"
      }
    },
    {
      "file": "apps/api/src/lib/audit-actions.ts",
      "kind": "plugin-array",
      "exportName": "AUDIT_ACTIONS",
      "arrayProp": "actions",
      "call": "ecommerceAuditActions",
      "import": {
        "name": "ecommerceAuditActions",
        "from": "../audit/ecommerce"
      }
    },
    {
      "file": "packages/payment/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/ecommerce",
      "range": "workspace:*"
    },
    {
      "file": "packages/payment/src/index.ts",
      "kind": "plugin-array",
      "exportName": "payment",
      "arrayProp": "listeners",
      "call": "orderPaymentListener",
      "import": {
        "name": "orderPaymentListener",
        "from": "@repo/ecommerce"
      }
    },
    {
      "file": "apps/admin/src/components/nav-counts.ts",
      "kind": "const-array",
      "constName": "NAV_COUNTS",
      "key": "to",
      "entry": {
        "to": "/shop/orders",
        "path": "/admin/shop/orders/awaiting-call-count"
      }
    },
    {
      "file": "apps/admin/src/components/nav.ts",
      "kind": "nav-entry",
      "constName": "NAV_AREAS",
      "area": "/",
      "group": "Shop",
      "entry": {
        "to": "/shop/products",
        "label": "Products"
      },
      "icon": {
        "name": "PackageIcon",
        "from": "lucide-react"
      }
    },
    {
      "file": "apps/admin/src/components/nav.ts",
      "kind": "nav-entry",
      "constName": "NAV_AREAS",
      "area": "/",
      "group": "Shop",
      "entry": {
        "to": "/shop/orders",
        "label": "Orders"
      },
      "icon": {
        "name": "ShoppingCartIcon",
        "from": "lucide-react"
      }
    },
    {
      "file": "apps/admin/src/components/nav.ts",
      "kind": "nav-entry",
      "constName": "NAV_AREAS",
      "area": "/",
      "group": "Shop",
      "entry": {
        "to": "/shop/customers",
        "label": "Customers"
      },
      "icon": {
        "name": "ContactIcon",
        "from": "lucide-react"
      }
    },
    {
      "file": "apps/admin/src/components/nav.ts",
      "kind": "nav-entry",
      "constName": "NAV_AREAS",
      "area": "/",
      "group": "Shop",
      "entry": {
        "to": "/shop/shipping-zones",
        "label": "Shipping zones"
      },
      "icon": {
        "name": "TruckIcon",
        "from": "lucide-react"
      }
    },
    {
      "file": "apps/admin/src/components/nav.ts",
      "kind": "nav-entry",
      "constName": "NAV_AREAS",
      "area": "/",
      "group": "Shop",
      "entry": {
        "to": "/shop/reports",
        "label": "Reports"
      },
      "icon": {
        "name": "ChartColumnIcon",
        "from": "lucide-react"
      }
    }
  ],
  "files": [
