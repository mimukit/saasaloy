{
  "$schema": "https://saasaloy.dev/schemas/registry-item.schema.json",
  "name": "ecommerce",
  "type": "saasaloy:feature",
  "description": "An in-house shop on Postgres: products with variants, stock holds, carts, orders with a status machine, and flat-rate shipping zones.",
  "stage": "money",
  "needs": [],
  "requires": {
    "saasaloy": ">=0.10.0"
  },
  "dependsOn": [
    "api",
    "database-postgres",
    "validators",
    "auth",
    "auth-phone",
    "admin",
    "file-uploads",
    "payment",
    "cms"
  ],
  "dependencies": [],
  "removeWarnings": [
    "The deployed tables survive this removal: product_categories, products, product_options, product_option_values, product_variants, product_images, variant_prices, inventory_levels, shipping_zones, orders, order_items, order_events, stock_reservations, stock_movements, carts, cart_items and customer_addresses, and the order_numbers sequence. Orders, order_items and order_events are the only record of what the shop sold, so export them first. Then run pnpm --filter @repo/db db:generate and review the drop migration before you apply it.",
    "The shop's payments stay in the payments table with reference_type order, and product images stay as file-uploads rows in storage_objects. Confirm or reject the open cash-on-delivery payments first: once ecommerce is gone, no listener moves an order.",
    "@repo/ecommerce stays in packages/payment/package.json, and in packages/db, apps/api, apps/admin and apps/web; apps/web also keeps @repo/auth and lucide-react. A package-json-dependency patch has no removal inverse, so drop those lines by hand and run pnpm install. Then check packages/payment/src/index.ts: if orderPaymentListener and its @repo/ecommerce import are still there because the remover refused to reverse the listener registration, delete both by hand."
  ],
  "patches": [
    {
      "file": "packages/db/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/ecommerce",
      "range": "workspace:*"
    },
    {
      "file": "apps/api/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/ecommerce",
      "range": "workspace:*"
    },
    {
      "file": "packages/payment/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/ecommerce",
      "range": "workspace:*"
    },
    {
      "file": "apps/admin/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/ecommerce",
      "range": "workspace:*"
    },
    {
      "file": "apps/web/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/ecommerce",
      "range": "workspace:*"
    },
    {
      "file": "apps/web/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "@repo/auth",
      "range": "workspace:*"
    },
    {
      "file": "apps/web/package.json",
      "kind": "package-json-dependency",
      "section": "dependencies",
      "name": "lucide-react",
      "range": "1.49.0"
    },
    {
      "file": "apps/web/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "assets.run_worker_first",
      "entry": "/shop"
    },
    {
      "file": "apps/web/wrangler.jsonc",
      "kind": "wrangler-binding",
      "bindingType": "assets.run_worker_first",
      "entry": "/shop/*"
    }
  ],
  "entries": [
    {
      "table": "config.sections",
      "call": "ecommerceConfig",
      "import": {
        "name": "ecommerceConfig",
        "from": "./sections/ecommerce"
      }
    },
    {
      "table": "api.routes",
      "path": "/shop",
      "call": "ecommerce",
      "import": {
        "name": "ecommerce",
        "from": "./routes/ecommerce"
      }
    },
    {
      "table": "api.routes",
      "path": "/admin/shop",
      "call": "adminEcommerce",
      "import": {
        "name": "adminEcommerce",
        "from": "./routes/admin-ecommerce"
      }
    },
    {
      "table": "audit.actions",
      "call": "ecommerceAuditActions",
      "import": {
        "name": "ecommerceAuditActions",
        "from": "../audit/ecommerce"
      }
    },
    {
      "table": "payment.listeners",
      "call": "orderPaymentListener",
      "import": {
        "name": "orderPaymentListener",
        "from": "@repo/ecommerce"
      }
    },
    {
      "table": "admin.navCounts",
      "entry": {
        "to": "/shop/orders",
        "path": "/admin/shop/orders/awaiting-call-count"
      }
    },
    {
      "table": "admin.nav",
      "area": "/",
      "group": "Shop",
      "entry": {
        "to": "/shop/products",
        "label": "Products"
      },
      "import": {
        "name": "PackageIcon",
        "from": "lucide-react"
      }
    },
    {
      "table": "admin.nav",
      "area": "/",
      "group": "Shop",
      "entry": {
        "to": "/shop/orders",
        "label": "Orders"
      },
      "import": {
        "name": "ShoppingCartIcon",
        "from": "lucide-react"
      }
    },
    {
      "table": "admin.nav",
      "area": "/",
      "group": "Shop",
      "entry": {
        "to": "/shop/customers",
        "label": "Customers"
      },
      "import": {
        "name": "ContactIcon",
        "from": "lucide-react"
      }
    },
    {
      "table": "admin.nav",
      "area": "/",
      "group": "Shop",
      "entry": {
        "to": "/shop/shipping-zones",
        "label": "Shipping zones"
      },
      "import": {
        "name": "TruckIcon",
        "from": "lucide-react"
      }
    },
    {
      "table": "admin.nav",
      "area": "/",
      "group": "Shop",
      "entry": {
        "to": "/shop/reports",
        "label": "Reports"
      },
      "import": {
        "name": "ChartColumnIcon",
        "from": "lucide-react"
      }
    },
    {
      "table": "ui.pageLinks",
      "entry": {
        "label": "Shop",
        "href": "/shop"
      }
    }
  ],
