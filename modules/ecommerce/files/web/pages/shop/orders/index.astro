---
// The signed-in buyer's orders, installed by `saasaloy add ecommerce`. On demand, not
// prerendered. Session only (plan 0106, "Order page access"): a signed-out visitor signs
// in by phone code first.
import { siteName } from "@repo/ui";
import { Footer } from "@repo/ui/blocks/footer";
import { OrdersPage } from "@web/components/shop/OrdersPage";
import { ShopNav } from "@web/components/shop/ShopNav";
import { shopCopy } from "@web/lib/shop";
import Layout from "../../../layouts/Layout.astro";

export const prerender = false;
---

<Layout title={`${shopCopy.orders} — ${siteName}`}>
  <meta slot="head" name="robots" content="noindex" />
  <ShopNav client:load siteName={siteName} current="orders" />
  <main id="main" tabindex="-1">
    <div class="section-container pt-28 pb-20 md:pt-36 md:pb-28">
      <h1 class="text-section-title mb-8">{shopCopy.orders}</h1>
      <OrdersPage client:load />
    </div>
  </main>
  <Footer siteName={siteName} />
</Layout>
