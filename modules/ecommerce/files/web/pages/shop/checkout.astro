---
// Checkout, installed by `saasaloy add ecommerce`. On demand, not prerendered. The island
// runs the steps (contact by phone code, delivery, payment) against the api with the
// browser's cookies.
import { siteName } from "@repo/ui";
import { Footer } from "@repo/ui/blocks/footer";
import { Checkout } from "@web/components/shop/Checkout";
import { ShopNav } from "@web/components/shop/ShopNav";
import { shopCopy } from "@web/lib/shop";
import Layout from "../../layouts/Layout.astro";

export const prerender = false;
---

<Layout title={`${shopCopy.checkout} — ${siteName}`}>
  <meta slot="head" name="robots" content="noindex" />
  <ShopNav client:load siteName={siteName} />
  <main id="main" tabindex="-1">
    <div class="section-container-wide pt-28 pb-20 md:pt-36 md:pb-28">
      <h1 class="text-section-title mb-8">{shopCopy.checkout}</h1>
      <Checkout client:load />
    </div>
  </main>
  <Footer siteName={siteName} />
</Layout>
