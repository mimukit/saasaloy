{
  "name": "@repo/cms",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf -g dist \"*.tsbuildinfo\"",
    "cms:rerender": "node --env-file-if-exists=../../apps/api/.env scripts/rerender.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./editor": "./src/editor.tsx",
    "./collections/*": "./src/collections/*.ts"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/static-renderer": "3.32.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-orm": "0.45.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
